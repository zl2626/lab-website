# ---------------------------------------------------------------------------
# 环境变量示例 —— 复制成 .env.local 供本地开发使用（.env.local 不要提交）
# 线上请在 Vercel 项目 Settings → Environment Variables 里配置
# ---------------------------------------------------------------------------

# 必填：Django 密钥。生成方法：
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=请替换成一串随机字符

# 数据库。绑定 Vercel Postgres / Neon 后会自动注入，一般无需手动填写
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 允许访问的域名，逗号分隔
DJANGO_ALLOWED_HOSTS=.vercel.app,.your-domain.com

# Django Admin 的 CSRF 白名单（必须带协议）
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://your-domain.com

# 前端构建时从哪个地址拉取内容（一般不用填）
# API_BASE=https://your-project.vercel.app

# 后台点「重建前台站点」时调用的 Vercel Deploy Hook
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxx/yyy

# 可选：AI 辅助功能（后台「用 AI 生成摘要」）
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat

# 本地调试用：设为 1 开启 Django DEBUG
# DJANGO_DEBUG=1
