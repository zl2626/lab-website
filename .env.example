# ---------------------------------------------------------------------------
# 环境变量示例 —— 复制成 .env.local 供本地开发使用（.env.local 不要提交）
# 线上请在 Vercel 项目 Settings → Environment Variables 里配置
# ---------------------------------------------------------------------------

# 必填：Django 密钥。生成方法：
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=请替换成一串随机字符

# 数据库。绑定 Vercel Postgres / Neon 后会自动注入，一般无需手动填写
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 允许访问的域名，逗号分隔
DJANGO_ALLOWED_HOSTS=.vercel.app,.your-domain.com

# Django Admin 的 CSRF 白名单（必须带协议）
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://your-domain.com

# 站点正式域名（同时用于 canonical / sitemap / 构建时拉取内容）
# 不填的话 Vercel 会自动用 VERCEL_PROJECT_PRODUCTION_URL 推断
# SITE_URL=https://your-project.vercel.app

# 前端构建时从哪个地址拉取内容（一般不用填，默认用 SITE_URL）
# API_BASE=https://your-project.vercel.app

# ── 自动重建（后台「🚀 重建并发布官网」按钮）────────────────────────────
# 线上是静态站点：后台保存只改数据库，必须重建一次才会反映到前台。
# 下面两种方式配好任意一种即可。

# 方式一：Vercel Deploy Hook（要求 Vercel 项目已连接 Git 仓库）
# 没连 Git 仓库的项目在 Vercel 上创建不了 Deploy Hook，请用方式二。
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxx/yyy

# 方式二：Vercel REST API（项目没连 Git 仓库时用这个）
# 取最近一次生产部署作为源重新构建，生产域名会自动指过去。
#   VERCEL_API_TOKEN   Vercel → Settings → Tokens 新建（vca_ 开头），建议单独建
#   VERCEL_PROJECT_ID  项目 → Settings → General → Project ID（prj_ 开头）
#   VERCEL_TEAM_ID     团队 → Settings → Team ID（team_ 开头），个人账号留空
# VERCEL_API_TOKEN=vca_xxx
# VERCEL_PROJECT_ID=prj_xxx
# VERCEL_TEAM_ID=team_xxx

# 可选：仅在本机构建时用。本机到 *.vercel.app 的 DNS 被污染（解析结果不是
# Vercel 的 IP）时，把域名固定到真实边缘节点，多个 IP 用逗号分隔、按顺序重试。
# 只影响构建期抓取内容，不会写进产物；CI 环境 DNS 正常，不需要配置。
# API_RESOLVE=my-project.vercel.app=76.76.21.98,216.198.79.65

# 可选：AI 辅助功能（后台「用 AI 生成摘要」）
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat

# 默认保存内容后会自动触发一次前端重建；设为 0 则改回手动点按钮
# AUTO_REBUILD_ON_SAVE=0

# 本地调试用：设为 1 开启 Django DEBUG
# DJANGO_DEBUG=1
