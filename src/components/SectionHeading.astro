---
import { u } from '../utils/url';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  actionLabel?: string;
  actionHref?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, actionLabel, actionHref, align = 'left' } = Astro.props;
---

<div class="section-head" class:list={[{ 'is-center': align === 'center' }]}>
  <div class="head-copy">
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2>{title}</h2>
  {description && <p>{description}</p>}
  </div>
  {
    actionLabel && actionHref && (
      <div class="head-action">
        <a class="btn btn-ghost" href={u(actionHref)}>{actionLabel}</a>
      </div>
    )
  }
</div>

<style>
  .is-center { text-align: center; }
  .is-center p { margin-left: auto; margin-right: auto; }
  .section-head { display: flex; align-items: end; justify-content: space-between; gap: 24px; }
  .head-copy { min-width: 0; }
  .head-action { flex-shrink: 0; }
  .is-center { flex-direction: column; align-items: center; }
  @media (max-width: 620px) { .section-head { align-items: start; flex-direction: column; gap: 16px; } .is-center { align-items: center; } }
</style>
