---
import type { NewsItem } from '../lib/content';
import { asset, u } from '../utils/url';
import { formatDate } from '../utils/format';

interface Props {
  item: NewsItem;
  index?: number;
}

const { item, index = 0 } = Astro.props;
---

<a
  class="card card-link news-card reveal"
  href={u(`/news/${item.slug}`)}
  style={`transition-delay:${index * 55}ms`}
>
  {item.cover && <img class="card-cover" src={asset(item.cover)} alt="" loading="lazy" />}
  <div class="meta">
    <time datetime={item.date}>{formatDate(item.date)}</time>
    {item.pinned && <span class="tag tag-gold">置顶</span>}
  </div>
  <h3>{item.title}</h3>
  {item.summary && <p class="summary">{item.summary}</p>}
  {
    item.tags.length > 0 && (
      <div class="row tags">
        {item.tags.map((t) => (
          <span class="tag tag-muted">#{t}</span>
        ))}
      </div>
    )
  }
</a>

<style>
  .card-cover { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 6px; margin-bottom: 18px; }
  .news-card { display: flex; flex-direction: column; height: 100%; }
  .meta { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .meta time { font-size: 0.8rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  h3 { font-size: 1.06rem; margin-bottom: 0.45em; }
  .summary { font-size: 0.92rem; margin: 0 0 1em; }
  .tags { gap: 6px; margin-top: auto; }
</style>
