---
import type { ResearchItem } from '../lib/content';
import { u } from '../utils/url';

interface Props {
  item: ResearchItem;
  index?: number;
}

const { item, index = 0 } = Astro.props;
---

<a
  class="card card-link research-card reveal"
  href={u(`/research/${item.slug}`)}
  style={`transition-delay:${index * 60}ms`}
>
  <span class="icon" aria-hidden="true">{item.icon}</span>
  <h3>{item.title}</h3>
  {item.titleEn && <p class="en">{item.titleEn}</p>}
  <p class="summary">{item.summary}</p>
  {
    item.keywords.length > 0 && (
      <div class="row tags">
        {item.keywords.slice(0, 4).map((k) => (
          <span class="tag tag-muted">{k}</span>
        ))}
      </div>
    )
  }
  <span class="more">查看详情 →</span>
</a>

<style>
  .research-card { display: flex; flex-direction: column; height: 100%; }
  .icon { font-size: 1.9rem; line-height: 1; margin-bottom: 14px; display: block; }
  .research-card h3 { margin-bottom: 0.2em; }
  .en { font-size: 0.82rem; color: var(--muted); margin: 0 0 0.7em; letter-spacing: 0.01em; }
  .summary { font-size: 0.93rem; margin: 0 0 1em; }
  .tags { gap: 6px; margin-top: auto; }
  .more { font-size: 0.86rem; font-weight: 600; color: var(--accent); margin-top: 14px; }
</style>
