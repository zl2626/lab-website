---
import type { PublicationItem as Pub } from '../lib/content';
import { publicationBibtex } from '../utils/bibtex.mjs';

interface Props {
  item: Pub;
  /** 界面文案（来自后台「站点设置 → 页面文案」） */
  copy: Record<string, string>;
}

const { item, copy } = Astro.props;
const bibtex = publicationBibtex(item);

const typeClass: Record<string, string> = {
  期刊论文: '',
  会议论文: 'tag-gold',
  预印本: 'tag-muted',
  专利: 'tag-muted',
  专著: 'tag-muted',
  获奖: 'tag-gold',
  项目: 'tag-muted',
};
---

<article class="pub" id={item.slug} data-type={item.type} data-year={item.year} data-area={item.area}>
  <div class="pub-year">{item.year}</div>
  <div class="pub-body">
    <div class="row top">
      <span class={`tag ${typeClass[item.type] ?? ''}`}>{item.type}</span>
      {item.venueShort && <span class="tag tag-muted">{item.venueShort}</span>}
      {item.highlight && <span class="tag tag-gold">{copy.pub_highlight_tag}</span>}
      {item.area && <span class="area">{item.area}</span>}
    </div>

    <h3 class="pub-title">{item.title}</h3>
    {item.authors.length > 0 && <p class="authors">{item.authors.join('，')}</p>}
    <p class="venue">{item.venue}</p>

    {
      (item.link || item.pdf || item.code) && (
        <div class="row links">
          {item.link && (
            <a href={item.link} target="_blank" rel="noopener">
              {copy.pub_link_original} ↗
            </a>
          )}
          {item.pdf && (
            <a href={item.pdf} target="_blank" rel="noopener">
              {copy.pub_link_pdf} ↗
            </a>
          )}
          {item.code && (
            <a href={item.code} target="_blank" rel="noopener">
              {copy.pub_link_code} ↗
            </a>
          )}
        </div>
      )
    }

    <div class="publication-details">
      {item.abstract && (
        <details>
          <summary>{copy.pub_abstract_toggle}</summary>
          <div class="detail-body">
            <p class="abstract">{item.abstract}</p>
          </div>
        </details>
      )}
      <details>
        <summary>{copy.pub_bibtex_toggle}</summary>
        <div class="detail-body">
          <pre><code>{bibtex}</code></pre>
          <p class="citation-note">
            {copy.pub_bibtex_note}
            <a class="citation-download" href={`data:application/x-bibtex;charset=utf-8,${encodeURIComponent(bibtex)}`} download={`${item.slug}.bib`}>{copy.pub_bibtex_download}</a>
          </p>
        </div>
      </details>
      <button
        type="button"
        class="cite-copy"
        data-cite-copy
        data-label-done={copy.pub_copy_done}
        data-label-failed={copy.pub_copy_failed}
        aria-live="polite"
      >{copy.pub_copy_cite}</button>
    </div>
  </div>
</article>

<script>
  import { copyText } from '../utils/clipboard.mjs';

  // 组件的 script 在整页只执行一次，所以这里用事件委托处理页面上所有的成果条目
  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-cite-copy]');
    if (!button) return;

    const code = button.closest('.publication-details')?.querySelector('pre code');
    const bibtex = code?.textContent ?? '';
    if (!bibtex.trim()) return;

    const label = button.dataset.labelDefault || button.textContent || '';
    const ok = await copyText(bibtex);
    button.textContent = ok ? button.dataset.labelDone || label : button.dataset.labelFailed || label;
    button.classList.toggle('is-done', ok);
    window.setTimeout(() => {
      button.textContent = label;
      button.classList.remove('is-done');
    }, 1800);
  });

  // 首次渲染时把按钮原始文案记下来，供恢复使用
  document.querySelectorAll<HTMLButtonElement>('[data-cite-copy]').forEach((button) => {
    button.dataset.labelDefault = (button.textContent || '').trim();
  });
</script>

<style>
  .pub {
    display: grid; grid-template-columns: 62px 1fr; gap: 18px;
    padding: 22px 0; border-bottom: 1px solid var(--border);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  /* 从站内搜索直接跳到某条成果时，给一个短暂的落点提示 */
  @keyframes pub-flash {
    0%, 25% { background-color: var(--accent-soft); }
    100% { background-color: transparent; }
  }
  .pub:target { animation: pub-flash 2.4s ease; }
  .pub-year {
    font-size: 0.92rem; font-weight: 700; color: var(--muted);
    font-variant-numeric: tabular-nums; padding-top: 3px;
  }
  .pub-body { min-width: 0; }
  .top { gap: 7px; margin-bottom: 9px; }
  .area { font-size: 0.76rem; color: var(--muted); margin-left: auto; }
  .pub-title { font-size: 1.06rem; margin: 0 0 0.4em; line-height: 1.45; }
  .authors { font-size: 0.88rem; color: var(--text-soft); margin: 0 0 0.25em; }
  .venue { font-size: 0.88rem; color: var(--muted); font-style: italic; margin: 0; }
  .links { gap: 14px; margin-top: 10px; }
  .links a { font-size: 0.85rem; font-weight: 600; }

  /* 折叠面板：收起时并排成两个小按钮，展开后占满整行 */
  .publication-details { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 8px; margin-top: 13px; }
  .publication-details details { flex: 0 1 auto; }
  .publication-details details[open] { flex: 1 1 100%; }
  summary {
    display: inline-flex; align-items: center; gap: 6px; width: fit-content;
    padding: 5px 13px; border: 1px solid var(--border); border-radius: 999px;
    background: var(--bg); color: var(--accent);
    font-size: 0.83rem; font-weight: 600; cursor: pointer; list-style: none;
    transition: 0.16s ease;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-weight: 700; line-height: 1; }
  details[open] summary::after { content: '−'; }
  summary:hover { border-color: var(--accent); background: var(--accent-soft); }
  summary:focus-visible { outline-offset: 2px; }
  /* 复制引用：与摘要在同一行的第三个胶囊按钮 */
  .cite-copy {
    display: inline-flex; align-items: center; gap: 6px; width: fit-content;
    padding: 5px 13px; border: 1px solid var(--border); border-radius: 999px;
    background: var(--bg); color: var(--accent);
    font: inherit; font-size: 0.83rem; font-weight: 600; cursor: pointer;
    transition: 0.16s ease;
  }
  .cite-copy:hover { border-color: var(--accent); background: var(--accent-soft); }
  .cite-copy.is-done { color: var(--gold); border-color: var(--gold); background: transparent; }
  .cite-copy:focus-visible { outline-offset: 2px; }
  .detail-body { margin-top: 10px; }
  .abstract {
    background: var(--bg-soft); padding: 14px 16px; border-radius: var(--radius-sm);
    border-left: 3px solid var(--border-strong); font-size: .9rem;
    white-space: pre-wrap; margin: 0;
  }
  pre {
    white-space: pre-wrap; overflow-wrap: anywhere; background: var(--bg-soft);
    border: 1px solid var(--border); padding: 16px; border-radius: var(--radius-sm);
    font-size: .8rem; margin: 0;
  }
  .citation-note { font-size: .78rem; color: var(--muted); margin: 9px 0 0; }
  .citation-download { font-weight: 600; margin-left: 6px; }

  @media (max-width: 560px) {
    .pub { grid-template-columns: 1fr; gap: 8px; }
    .pub-year { padding-top: 0; }
    .area { margin-left: 0; }
  }
</style>
