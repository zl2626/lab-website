---
/**
 * 站内搜索弹层（对标 academicpages / Minimal Mistakes 的站内检索）。
 *
 * 纯静态实现：索引在构建时生成（/search-index.json），第一次打开时才拉取。
 * 键盘：⌘K / Ctrl+K 打开，↑↓ 选择，Enter 打开，Esc 关闭。
 * 所有面向访客的文字都来自后台「站点设置 → 页面文案 → 站内搜索」。
 */
interface Props {
  copy: Record<string, string>;
}

const { copy } = Astro.props;

// 结果分组直接用各栏目自己的标题，改标题时搜索里也会同步
const typeLabels: { type: string; label: string }[] = [
  { type: 'research', label: copy.research_title },
  { type: 'member', label: copy.team_title },
  { type: 'publication', label: copy.publications_title },
  { type: 'project', label: copy.projects_title },
  { type: 'news', label: copy.news_title },
];

const clientCopy = {
  labels: Object.fromEntries(typeLabels.map((item) => [item.type, item.label])),
  found: copy.search_found,
  empty: copy.search_empty,
  failed: copy.search_failed,
  hint: copy.search_hint,
};
---

<dialog id="site-search" class="search-dialog" aria-labelledby="search-title">
  <div class="search-panel">
    <h2 id="search-title" class="sr-only">{copy.search_label}</h2>

    <div class="search-field">
      <span class="search-icon" aria-hidden="true">⌕</span>
      <input
        id="search-input"
        type="search"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
        placeholder={copy.search_placeholder}
        aria-controls="search-results"
        aria-expanded="false"
        aria-autocomplete="list"
        aria-describedby="search-status"
        role="combobox"
      />
      <button type="button" class="search-cancel" data-search-close aria-label={copy.search_key_close}>
        <span class="kbd">Esc</span>
      </button>
    </div>

    <p id="search-status" class="search-status" role="status" aria-live="polite">{copy.search_hint}</p>

    <ul id="search-results" class="search-results" hidden></ul>

    <div class="search-suggest">
      {typeLabels.map((group) => (
        <span class="search-chip" data-search-suggest={group.type}>{group.label}</span>
      ))}
    </div>

    <p class="search-foot">
      <span><b class="kbd">↑</b><b class="kbd">↓</b> {copy.search_key_select}</span>
      <span><b class="kbd">Enter</b> {copy.search_key_open}</span>
      <span><b class="kbd">Esc</b> {copy.search_key_close}</span>
    </p>
  </div>

  <script type="application/json" id="search-client-copy" set:html={JSON.stringify(clientCopy)} />
</dialog>

<style is:global>
  /* 搜索结果由脚本动态生成，拿不到 Astro 的作用域属性，
     因此这里的样式必须全局生效（类名都带 search- 前缀，不会外溢）。 */
  .search-dialog {
    padding: 0; border: 0; background: transparent;
    width: min(680px, calc(100vw - 32px));
    max-width: none; max-height: none;
    margin: 12vh auto auto;
    overflow: visible;
  }
  .search-dialog::backdrop {
    background: rgba(11, 18, 30, 0.55);
    backdrop-filter: blur(3px);
  }
  .search-panel {
    background: var(--bg); border: 1px solid var(--border);
    border-radius: 14px; box-shadow: var(--shadow-lg);
    overflow: hidden; display: flex; flex-direction: column;
    max-height: min(70vh, 620px);
  }

  .search-field { display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--border); }
  .search-icon { font-size: 1.25rem; color: var(--muted); line-height: 1; }
  .search-field input {
    flex: 1; min-width: 0; border: 0; outline: none; background: transparent;
    color: var(--text); font-size: 1.02rem; padding: 4px 0;
  }
  .search-field input::placeholder { color: var(--muted); }
  /* 隐藏原生清除按钮，避免与右侧的 Esc 徽标重复 */
  .search-field input::-webkit-search-cancel-button,
  .search-field input::-webkit-search-decoration { -webkit-appearance: none; appearance: none; }
  .search-cancel { border: 0; background: transparent; cursor: pointer; padding: 4px; }
  .search-cancel:hover { opacity: 0.75; }
  .kbd {
    display: inline-block; font-family: var(--font-mono); font-size: 0.72rem;
    padding: 2px 7px; border: 1px solid var(--border-strong); border-radius: 5px;
    background: var(--bg-soft); color: var(--text-soft); font-weight: 600; line-height: 1.5;
  }

  .search-status { margin: 0; padding: 12px 18px 4px; font-size: 0.84rem; color: var(--muted); }
  .search-results {
    list-style: none; margin: 0; padding: 6px 8px 10px;
    overflow-y: auto; flex: 1; min-height: 0;
  }
  .search-group {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--muted); padding: 12px 10px 6px;
  }
  .search-item { display: block; }
  .search-item a {
    display: block; padding: 10px 12px; border-radius: 9px; color: var(--text);
    text-decoration: none !important; border: 1px solid transparent;
  }
  .search-item a:hover { background: var(--bg-soft); }
  .search-item.is-active a { background: var(--accent-soft); border-color: color-mix(in srgb, var(--accent) 30%, transparent); }
  .search-item .t { font-size: 0.95rem; font-weight: 600; line-height: 1.5; }
  .search-item .s {
    font-size: 0.82rem; color: var(--muted); margin-top: 3px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .search-item mark { background: color-mix(in srgb, var(--gold) 30%, transparent); color: inherit; border-radius: 3px; padding: 0 2px; }

  .search-suggest { display: flex; flex-wrap: wrap; gap: 8px; padding: 0 18px 14px; }
  .search-chip {
    font-size: 0.8rem; padding: 5px 12px; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--border); color: var(--text-soft); background: var(--bg);
  }
  .search-chip:hover { border-color: var(--accent); color: var(--accent); }

  .search-foot {
    display: flex; flex-wrap: wrap; gap: 16px; margin: 0;
    padding: 10px 18px; border-top: 1px solid var(--border);
    background: var(--bg-soft); font-size: 0.78rem; color: var(--muted);
  }
  .search-foot span { display: inline-flex; align-items: center; gap: 5px; }

  @media (max-width: 640px) {
    .search-dialog { width: 100vw; margin: 0; height: 100dvh; }
    .search-panel { border-radius: 0; border: 0; height: 100dvh; max-height: none; }
    .search-foot { justify-content: center; }
  }
</style>

<script>
  import { escapeHtml, highlightMatches, searchEntries, tokenize } from '../utils/search.mjs';
  import { fillCopy } from '../utils/copy.mjs';

  interface Entry {
    type: 'research' | 'member' | 'news' | 'publication' | 'project';
    title: string;
    subtitle: string;
    url: string;
    text: string;
  }

  const dialog = document.getElementById('site-search') as HTMLDialogElement | null;
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const list = document.getElementById('search-results') as HTMLUListElement | null;
  const status = document.getElementById('search-status');
  const suggest = document.querySelector<HTMLElement>('.search-suggest');
  if (!dialog || !input || !list) throw new Error('search dialog markup missing');

  // 文案由服务端下发（后台「页面文案 → 站内搜索」）
  const clientCopy = JSON.parse(document.getElementById('search-client-copy')?.textContent || '{}') as {
    labels?: Record<string, string>;
    found?: string;
    empty?: string;
    failed?: string;
    hint?: string;
  };
  const TYPE_LABEL: Record<Entry['type'], string> = {
    research: clientCopy.labels?.research || '研究方向',
    member: clientCopy.labels?.member || '团队成员',
    news: clientCopy.labels?.news || '科研新闻',
    publication: clientCopy.labels?.publication || '科研成果',
    project: clientCopy.labels?.project || '科研项目',
  };
  const MAX_RESULTS = 18;

  let entries: Entry[] = [];
  let indexState: 'idle' | 'loading' | 'ready' | 'failed' = 'idle';
  let indexPromise: Promise<void> | null = null;
  let results: Entry[] = [];
  let active = -1;

  const indexUrl = `${import.meta.env.BASE_URL}search-index.json`.replace(/\/{2,}/g, '/');

  function loadIndex(): Promise<void> {
    if (indexState === 'ready' || indexState === 'failed') return Promise.resolve();
    if (indexPromise) return indexPromise;
    indexState = 'loading';
    indexPromise = (async () => {
      try {
        const response = await fetch(indexUrl, { credentials: 'same-origin' });
        if (!response.ok) throw new Error(String(response.status));
        const data = (await response.json()) as { entries?: Entry[] };
        entries = Array.isArray(data.entries) ? data.entries : [];
        indexState = 'ready';
      } catch {
        indexState = 'failed';
        setStatus(clientCopy.failed || '搜索索引加载失败，请刷新页面后重试。');
      }
    })();
    return indexPromise;
  }

  function setStatus(text: string) {
    if (status) status.textContent = text;
  }

  function render() {
    const query = input!.value.trim();
    const tokens = tokenize(query);

    if (!query) {
      results = [];
      list!.hidden = true;
      list!.innerHTML = '';
      active = -1;
      input!.setAttribute('aria-expanded', 'false');
      input!.removeAttribute('aria-activedescendant');
      if (suggest) suggest.hidden = false;
      setStatus(
        indexState === 'failed'
          ? clientCopy.failed || '搜索索引加载失败，请刷新页面后重试。'
          : clientCopy.hint || ''
      );
      return;
    }

    if (suggest) suggest.hidden = true;
    results = searchEntries(entries, query, MAX_RESULTS) as Entry[];
    active = results.length ? 0 : -1;

    if (results.length === 0) {
      list!.hidden = true;
      list!.innerHTML = '';
      setStatus(fillCopy(clientCopy.empty || '没有找到与「{query}」相关的内容。', { query }));
      input!.setAttribute('aria-expanded', 'false');
      input!.removeAttribute('aria-activedescendant');
      return;
    }

    let html = '';
    let lastType = '';
    results.forEach((entry, i) => {
      if (entry.type !== lastType) {
        lastType = entry.type;
        html += `<li class="search-group" role="presentation">${escapeHtml(TYPE_LABEL[entry.type] || '')}</li>`;
      }
      html += `<li class="search-item${i === active ? ' is-active' : ''}" id="search-opt-${i}">
        <a href="${escapeHtml(entry.url)}">
          <span class="t">${highlightMatches(entry.title, tokens)}</span>
          ${entry.subtitle ? `<span class="s">${highlightMatches(entry.subtitle, tokens)}</span>` : ''}
        </a>
      </li>`;
    });
    list!.innerHTML = html;
    list!.hidden = false;
    input!.setAttribute('aria-expanded', 'true');
    syncActive();
    setStatus(fillCopy(clientCopy.found || '找到 {count} 条结果。', { count: results.length }));
  }

  function syncActive() {
    const items = list!.querySelectorAll<HTMLElement>('.search-item');
    items.forEach((item, i) => item.classList.toggle('is-active', i === active));
    const current = items[active];
    if (current) {
      input!.setAttribute('aria-activedescendant', current.id);
      current.scrollIntoView({ block: 'nearest' });
    }
  }

  function move(delta: number) {
    if (!results.length) return;
    active = (active + delta + results.length) % results.length;
    syncActive();
  }

  function openLink(index: number) {
    const target = results[index];
    if (!target) return;
    close();
    // 同一页内的锚点直接滚动，避免整页重载
    const [path, hash] = target.url.split('#');
    const samePage = path.replace(/\/$/, '') === window.location.pathname.replace(/\/$/, '');
    if (hash && samePage) {
      const el = document.getElementById(hash);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', `#${hash}`);
        return;
      }
    }
    window.location.href = target.url;
  }

  function open() {
    if (dialog!.open) return;
    dialog!.showModal();
    loadIndex();
    // 让浏览器先把 dialog 放进布局，再聚焦，避免移动端键盘闪烁
    requestAnimationFrame(() => {
      input!.focus();
      if (!input!.value.trim()) render();
    });
  }

  function close() {
    if (dialog!.open) dialog!.close();
  }

  /** 支持通过 /?q=关键词 直接带词打开（结构化数据里的 SearchAction 指向这里） */
  async function openWithQuery(query: string) {
    open();
    await loadIndex();
    input!.value = query;
    render();
    input!.focus();
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('[data-search-open]')) {
      event.preventDefault();
      open();
      return;
    }
    if (target.closest('[data-search-close]')) {
      close();
      return;
    }
    const chip = target.closest<HTMLElement>('[data-search-suggest]');
    if (chip) {
      input!.value = TYPE_LABEL[chip.dataset.searchSuggest as Entry['type']] ?? '';
      render();
      input!.focus();
    }
  });

  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) close(); // 点击遮罩关闭
  });

  input.addEventListener('input', render);

  input.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') { move(1); event.preventDefault(); }
    else if (event.key === 'ArrowUp') { move(-1); event.preventDefault(); }
    else if (event.key === 'Enter') {
      if (active >= 0) { openLink(active); event.preventDefault(); }
    }
  });

  list.addEventListener('mousemove', (event) => {
    const item = (event.target as HTMLElement).closest<HTMLElement>('.search-item');
    if (!item) return;
    active = Number(item.id.replace('search-opt-', ''));
    syncActive();
  });

  list.addEventListener('click', (event) => {
    const anchor = (event.target as HTMLElement).closest('a');
    const item = (event.target as HTMLElement).closest<HTMLElement>('.search-item');
    if (anchor && item) {
      event.preventDefault();
      openLink(Number(item.id.replace('search-opt-', '')));
    }
  });

  dialog.addEventListener('close', () => {
    input.value = '';
    results = [];
    active = -1;
    render();
  });

  // ⌘K / Ctrl+K 打开；「/」在非输入状态下也能打开
  document.addEventListener('keydown', (event) => {
    const typing = /^(INPUT|TEXTAREA|SELECT)$/.test((event.target as HTMLElement).tagName) || (event.target as HTMLElement).isContentEditable;
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      dialog.open ? close() : open();
      return;
    }
    if (event.key === '/' && !typing && !dialog.open) {
      event.preventDefault();
      open();
    }
  });

  // 从外部链接带词进入：/?q=关键词
  const initialQuery = new URLSearchParams(window.location.search).get('q');
  if (initialQuery) openWithQuery(initialQuery.trim());
</script>
