---
import type { SiteInfo } from '../lib/content';
import { stripBase, u } from '../utils/url';

interface Props {
  site: SiteInfo;
}

const { site } = Astro.props;
const copy = site.pageCopy;

// Astro.url.pathname 在子路径部署（GitHub Pages）下是 /lab-website/team/，
// 导航项里存的却是 /team，必须先剥掉 base 再比较，否则高亮永远不生效。
const path = stripBase(Astro.url.pathname).replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  if (h === '/') return path === '/';
  return path === h || path.startsWith(h + '/');
};
const isHome = path === '/';
---

<header class="site-header" data-home={isHome ? 'true' : 'false'}>
  <div class="container header-inner">
    <a class="brand" href={u('/')} aria-label={`${site.name} 首页`}>
      <span class="brand-mark" aria-hidden="true">{site.abbr}</span>
      <span class="brand-text">
        <strong>{site.name}</strong>
        {site.nameEn && <em>{site.nameEn}</em>}
      </span>
    </a>

    <div class="header-actions">
      <button type="button" class="search-trigger" data-search-open aria-label={copy.search_label}>
        <span class="search-glyph" aria-hidden="true">⌕</span>
        <span class="search-label">{copy.search_label}</span>
        <kbd class="search-kbd" aria-hidden="true">⌘K</kbd>
      </button>
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="切换深色模式">
        <span class="icon-sun" aria-hidden="true">☀</span>
        <span class="icon-moon" aria-hidden="true">☾</span>
      </button>
    </div>
  </div>

  <nav class="nav-bar" aria-label="主导航">
    <div class="container nav-wrap">
      <div class="nav-items">
        {
          site.nav.map((item) => (
            <a
              href={u(item.href)}
              class:list={['nav-link', { active: isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  /* ---------- 品牌区 ---------- */
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    height: 68px;
  }
  .brand { min-width: 0; display: flex; align-items: center; gap: 11px; text-decoration: none !important; }
  .brand-mark {
    width: 38px; height: 38px; flex: 0 0 38px; border-radius: 11px;
    display: grid; place-items: center;
    background: linear-gradient(140deg, var(--accent), var(--accent-strong));
    color: var(--on-accent); font-weight: 800; font-size: 0.72rem; letter-spacing: 0.02em;
  }
  .brand-text { min-width: 0; display: flex; flex-direction: column; line-height: 1.2; }
  .brand-text strong { color: var(--text); font-size: 1rem; letter-spacing: -0.01em; }
  .brand-text em { color: var(--muted); font-size: 0.68rem; font-style: normal; letter-spacing: 0.02em; }

  /* ---------- 导航条：跟随主题的浅表面，不再是硬编码灰条 ---------- */
  .nav-bar { background: var(--bg-soft); border-top: 1px solid var(--border); }
  .nav-wrap { position: relative; }
  .nav-items {
    display: flex; flex-wrap: nowrap; align-items: center; justify-content: center; gap: 2px;
    overflow-x: auto; scrollbar-width: none; -ms-overflow-style: none;
    /* 移动端横向滚动时，右侧渐变淡出作为“还有内容”的提示 */
    mask-image: linear-gradient(90deg, #000 calc(100% - 34px), transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 34px), transparent 100%);
  }
  .nav-items::-webkit-scrollbar { display: none; }
  .nav-link {
    position: relative; flex: 0 0 auto; white-space: nowrap;
    padding: 14px 15px; font-size: 0.88rem; font-weight: 600;
    color: var(--text-soft); text-decoration: none !important;
    transition: color 0.16s ease, background-color 0.16s ease;
  }
  .nav-link::after {
    content: ''; position: absolute; left: 15px; right: 15px; bottom: 0; height: 2px;
    background: var(--accent); border-radius: 2px 2px 0 0;
    transform: scaleX(0); transform-origin: center; transition: transform 0.2s ease;
  }
  .nav-link:hover { color: var(--accent); background: var(--bg-inset); }
  .nav-link:hover::after { transform: scaleX(1); }
  .nav-link.active { color: var(--accent); font-weight: 700; }
  .nav-link.active::after { transform: scaleX(1); }
  .nav-link:focus-visible { outline-offset: -3px; }

  /* ---------- 搜索入口 / 主题切换 ---------- */
  .header-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .search-trigger {
    display: inline-flex; align-items: center; gap: 7px; cursor: pointer;
    height: 42px; padding: 0 12px; border-radius: 10px;
    border: 1px solid var(--border); background: var(--bg); color: var(--text-soft);
    font-size: 0.86rem; font-weight: 600; transition: 0.16s ease;
  }
  .search-trigger:hover { border-color: var(--border-strong); color: var(--accent); }
  .search-glyph { font-size: 1.15rem; line-height: 1; }
  .search-kbd {
    font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600;
    padding: 2px 6px; border-radius: 5px; border: 1px solid var(--border);
    background: var(--bg-soft); color: var(--muted); line-height: 1.6;
  }
  .theme-toggle {
    width: 42px; height: 42px; border-radius: 10px; cursor: pointer; flex-shrink: 0;
    border: 1px solid var(--border); background: var(--bg); color: var(--text-soft);
    display: grid; place-items: center; font-size: 1rem; transition: 0.16s ease;
  }
  .theme-toggle:hover { border-color: var(--border-strong); color: var(--accent); }
  html[data-theme='dark'] .icon-sun,
  html[data-theme='light'] .icon-moon { display: none; }
  html[data-theme='dark'] .icon-moon,
  html[data-theme='light'] .icon-sun { display: block; }

  /* ---------- 首页：覆盖在大图之上，滚动后过渡为实底 ---------- */
  .site-header[data-home='true'] {
    position: fixed;
    inset: 0 0 auto;
    background: transparent;
    border-bottom-color: transparent;
    transition: background-color 0.28s ease, border-color 0.28s ease, box-shadow 0.28s ease;
  }
  .site-header[data-home='true'] .header-inner { height: 76px; }
  .site-header[data-home='true'] .brand-text strong { color: #fff; }
  .site-header[data-home='true'] .brand-text em { color: #d4e0e7; }
  .site-header[data-home='true'] .brand-mark {
    background: transparent; border: 1px solid #d4e0e7; color: #fff;
  }
  .site-header[data-home='true'] .theme-toggle {
    background: rgba(255, 255, 255, 0.08); color: #fff; border-color: rgba(255, 255, 255, 0.4);
  }
  .site-header[data-home='true'] .theme-toggle:hover { background: rgba(255, 255, 255, 0.18); color: #fff; }
  .site-header[data-home='true'] .search-trigger {
    background: rgba(255, 255, 255, 0.08); color: #fff; border-color: rgba(255, 255, 255, 0.4);
  }
  .site-header[data-home='true'] .search-trigger:hover { background: rgba(255, 255, 255, 0.18); color: #fff; }
  .site-header[data-home='true'] .search-kbd {
    background: rgba(255, 255, 255, 0.12); border-color: rgba(255, 255, 255, 0.3); color: #eaf1f6;
  }
  .site-header[data-home='true'] .nav-bar { background: transparent; border-top-color: transparent; }
  .site-header[data-home='true'] .nav-link { color: #e8eef3; }
  .site-header[data-home='true'] .nav-link:hover { color: #fff; background: rgba(255, 255, 255, 0.14); }
  .site-header[data-home='true'] .nav-link.active { color: #fff; }
  .site-header[data-home='true'] .nav-link::after { background: #fff; }
  .site-header[data-home='true'] .nav-link:focus-visible { outline-color: #fff; }

  /* 滚动离开首屏后恢复为普通实底头部 */
  .site-header[data-home='true'].is-scrolled {
    background: var(--bg);
    border-bottom-color: var(--border);
    box-shadow: 0 6px 24px -18px rgba(16, 24, 40, 0.5);
  }
  .site-header[data-home='true'].is-scrolled .header-inner { height: 64px; }
  .site-header[data-home='true'].is-scrolled .brand-text strong { color: var(--text); }
  .site-header[data-home='true'].is-scrolled .brand-text em { color: var(--muted); }
  .site-header[data-home='true'].is-scrolled .brand-mark {
    background: linear-gradient(140deg, var(--accent), var(--accent-strong));
    border-color: transparent; color: var(--on-accent);
  }
  .site-header[data-home='true'].is-scrolled .theme-toggle {
    background: var(--bg); color: var(--text-soft); border-color: var(--border);
  }
  .site-header[data-home='true'].is-scrolled .nav-bar { background: var(--bg-soft); border-top-color: var(--border); }
  .site-header[data-home='true'].is-scrolled .nav-link { color: var(--text-soft); }
  .site-header[data-home='true'].is-scrolled .nav-link:hover { color: var(--accent); background: var(--bg-inset); }
  .site-header[data-home='true'].is-scrolled .nav-link.active { color: var(--accent); }
  .site-header[data-home='true'].is-scrolled .nav-link::after { background: var(--accent); }

  @media (max-width: 800px) {
    .nav-items { justify-content: flex-start; padding-inline: 10px; gap: 0; }
    .nav-link { padding: 13px 12px; }
    .nav-link::after { left: 12px; right: 12px; }
    /* 窄屏只留图标，节省横向空间 */
    .search-label, .search-kbd { display: none; }
    .search-trigger { padding: 0; width: 42px; justify-content: center; }
  }
  @media (max-width: 480px) {
    .header-inner { gap: 10px; }
    .brand-text strong { font-size: 0.85rem; }
    .brand-text em { display: none; }
    .brand-mark { width: 32px; height: 32px; flex-basis: 32px; }
    .brand { gap: 8px; }
    .theme-toggle { width: 38px; height: 38px; }
    .search-trigger { width: 38px; height: 38px; }
  }
</style>

<script>
  // 主题切换
  const themeBtn = document.getElementById('theme-toggle');
  function syncThemeLabel() {
    const dark = document.documentElement.getAttribute('data-theme') === 'dark';
    themeBtn?.setAttribute('aria-label', dark ? '切换浅色模式' : '切换深色模式');
  }
  syncThemeLabel();
  themeBtn?.addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    syncThemeLabel();
    try { localStorage.setItem('theme', next); } catch {}
  });

  // 首页头部：滚动离开首屏后由透明浮层切换为实底
  const header = document.querySelector<HTMLElement>('.site-header[data-home="true"]');

  /**
   * 把顶栏真实高度写入 --header-h。
   * 吸顶元素（成果页的年份标题等）依赖这个变量，写死数值会随字号/断点漂移，
   * 因此统一在运行时测量，并在窗口尺寸变化后重新校准。
   */
  const headerEl = document.querySelector<HTMLElement>('.site-header');
  function syncHeaderHeight() {
    if (!headerEl) return;
    const height = Math.round(headerEl.getBoundingClientRect().height);
    if (height > 0) document.documentElement.style.setProperty('--header-h', `${height}px`);
  }
  syncHeaderHeight();
  window.addEventListener('resize', syncHeaderHeight, { passive: true });
  window.addEventListener('load', syncHeaderHeight);
  // 字体加载完成后顶栏高度可能变化，需重新测量
  document.fonts?.ready.then(syncHeaderHeight).catch(() => {});
  if (headerEl && 'ResizeObserver' in window) {
    new ResizeObserver(syncHeaderHeight).observe(headerEl);
  }

  if (header) {
    let ticking = false;
    const apply = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 72);
      syncHeaderHeight();
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) { ticking = true; requestAnimationFrame(apply); }
    };
    apply();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
