---
import type { SiteInfo } from '../lib/content';
import { stripBase, u } from '../utils/url';

interface Props { site: SiteInfo; }
const { site } = Astro.props;
const copy = site.pageCopy;
const path = stripBase(Astro.url.pathname).replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  return h === '/' ? path === '/' : path === h || path.startsWith(h + '/');
};
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={u('/')} aria-label={site.name + ' 首页'}>
      <span class="brand-mark" aria-hidden="true">{site.abbr}</span>
      <span class="brand-text"><strong>{site.name}</strong>{site.nameEn && <em>{site.nameEn}</em>}</span>
    </a>
    <nav class="desktop-nav" aria-label="主导航">
      {site.nav.map((item) => <a class:list={['nav-link', { active: isActive(item.href) }]} href={u(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <div class="header-actions">
      <button type="button" class="search-trigger" data-search-open aria-label={copy.search_label}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
      </button>
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="切换深色模式">
        <span class="icon-sun" aria-hidden="true">☀</span><span class="icon-moon" aria-hidden="true">☾</span>
      </button>
      <button type="button" class="mobile-nav-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="打开导航菜单">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path class="menu-lines" d="M3 6h18M3 12h18M3 18h18" /><path class="menu-close" d="m5 5 14 14M19 5 5 19" /></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="移动主导航" hidden>
    <div class="container">
      {site.nav.map((item) => <a class:list={['nav-link', { active: isActive(item.href) }]} href={u(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </div>
  </nav>
</header>

<style>
  .site-header { position: fixed; inset: 0 0 auto; z-index: 60; background: var(--header-bg); color: #fff; border-bottom: 1px solid rgba(255,255,255,.16); }
  .header-inner { display: flex; align-items: center; gap: 24px; min-height: 88px; }
  .brand { min-width: 0; display: flex; align-items: center; gap: 12px; color: #fff; text-decoration: none; margin-right: auto; min-height: 44px; }
  .brand-mark { display: grid; place-items: center; width: 44px; height: 44px; flex: 0 0 44px; font-size: .72rem; font-weight: 700; letter-spacing: .04em; border: 1px solid rgba(255,255,255,.6); }
  .brand-text { display: flex; flex-direction: column; min-width: 0; line-height: 1.4; }
  .brand-text strong { font-size: 1.02rem; font-weight: 600; overflow-wrap: anywhere; }
  .brand-text em { font-size: .64rem; font-style: normal; color: #d8e6fb; }
  .desktop-nav { display: flex; align-items: center; flex-wrap: nowrap; gap: 6px; flex-shrink: 0; }
  .nav-link { position: relative; display: flex; align-items: center; min-height: 44px; padding: 12px 10px; color: #e5efff; font-size: .9rem; white-space: nowrap; text-decoration: none; }
  .nav-link:hover, .nav-link.active { color: #fff; background: rgba(255,255,255,.09); }
  .nav-link.active::after { content: ''; position: absolute; height: 2px; bottom: 4px; left: 10px; right: 10px; background: #fff; }
  .header-actions { display: flex; align-items: center; gap: 4px; flex-shrink: 0; }
  .header-actions button { width: 44px; height: 44px; padding: 0; display: grid; place-items: center; background: transparent; color: #fff; border: 1px solid transparent; cursor: pointer; border-radius: 3px; }
  .header-actions button:hover { background: rgba(255,255,255,.12); }
  .site-header :focus-visible { outline-color: #fff; outline-offset: -3px; }
  .icon-sun, .icon-moon { font-size: 1.15rem; }
  :global(html[data-theme='dark']) .icon-sun, :global(html[data-theme='light']) .icon-moon { display: none; }
  .header-actions .mobile-nav-toggle { display: none; }
  .menu-close { display: none; }
  .mobile-nav-toggle[aria-expanded='true'] .menu-lines { display: none; }
  .mobile-nav-toggle[aria-expanded='true'] .menu-close { display: block; }
  .mobile-nav { position: absolute; inset: 100% 0 auto; background: var(--header-bg); border-top: 1px solid rgba(255,255,255,.18); border-bottom: 1px solid rgba(255,255,255,.18); max-height: calc(100dvh - var(--header-h)); overflow-y: auto; overscroll-behavior: contain; box-shadow: 0 12px 20px rgba(4,25,56,.12); }
  .mobile-nav > div { padding-block: 12px 20px; }
  .mobile-nav .nav-link { min-height: 48px; padding-inline: 16px; white-space: normal; overflow-wrap: anywhere; }
  .mobile-nav .nav-link.active::after { inset: 12px auto 12px 0; width: 2px; height: auto; }
  @media (max-width: 1024px) {
    .header-inner { gap: 16px; min-height: 80px; }
    .brand-text em { display: none; }
    .brand-text strong { font-size: .92rem; }
    .desktop-nav { gap: 0; }
    .nav-link { font-size: .84rem; padding-inline: 8px; }
  }
  @media (max-width: 768px) {
    .header-inner { min-height: 76px; gap: 12px; }
    .desktop-nav { display: none; }
    .header-actions .mobile-nav-toggle { display: grid; }
    .brand-mark { width: 38px; height: 38px; flex-basis: 38px; font-size: .64rem; }
    .brand { gap: 9px; }
    .brand-text strong { font-size: .88rem; }
  }
  @media (max-width: 390px) {
    .header-inner { gap: 8px; }
    .brand-mark { display: none; }
    .brand-text strong { font-size: .83rem; }
    .header-actions { gap: 0; }
  }
  @media (max-width: 320px) {
    .brand-text strong { font-size: .78rem; }
    .header-inner { gap: 4px; }
  }
</style>

<script>
  const themeBtn = document.getElementById('theme-toggle');
  function syncThemeLabel() {
    const dark = document.documentElement.getAttribute('data-theme') === 'dark';
    themeBtn?.setAttribute('aria-label', dark ? '切换浅色模式' : '切换深色模式');
  }
  syncThemeLabel();
  themeBtn?.addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    syncThemeLabel();
    try { localStorage.setItem('theme', next); } catch {}
  });

  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('.mobile-nav-toggle');
  const panel = document.getElementById('mobile-nav');
  const mobile = window.matchMedia('(max-width: 768px)');
  function setMenu(open: boolean, returnFocus = false) {
    if (!toggle || !panel) return;
    const expanded = open && mobile.matches;
    toggle.setAttribute('aria-expanded', String(expanded));
    toggle.setAttribute('aria-label', expanded ? '关闭导航菜单' : '打开导航菜单');
    panel.hidden = !expanded;
    if (returnFocus) toggle.focus();
  }
  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false, true);
    }
    // 搜索快捷键打开原生 dialog 前关闭导航，不干扰 dialog 的焦点管理。
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k' || event.key === '/') setMenu(false);
  });
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (!header?.contains(target) || target.closest('[data-search-open]') || target.closest('#mobile-nav a')) setMenu(false);
  });
  document.addEventListener('focusin', (event) => {
    if (event.target instanceof Node && !header?.contains(event.target)) setMenu(false);
  });
  mobile.addEventListener('change', () => {
    const focusWasInPanel = panel?.contains(document.activeElement);
    setMenu(false);
    if (focusWasInPanel) header?.querySelector<HTMLAnchorElement>('.desktop-nav a[aria-current="page"], .desktop-nav a')?.focus();
  });
  // 非模态导航不锁定 body；菜单内部限高滚动，关闭/切换断点不会遗留滚动锁。
  function syncHeaderHeight() {
    const height = Math.round(header?.getBoundingClientRect().height || 0);
    if (height > 0) document.documentElement.style.setProperty('--header-h', height + 'px');
  }
  syncHeaderHeight();
  window.addEventListener('resize', syncHeaderHeight, { passive: true });
  window.addEventListener('load', syncHeaderHeight);
  document.fonts?.ready.then(syncHeaderHeight).catch(() => {});
  if (header && 'ResizeObserver' in window) new ResizeObserver(syncHeaderHeight).observe(header);
</script>
