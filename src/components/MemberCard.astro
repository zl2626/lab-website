---
import type { MemberItem } from '../lib/content';
import { asset, u } from '../utils/url';
import { initials } from '../utils/format';

interface Props {
  item: MemberItem;
  /** 界面文案（来自后台「站点设置 → 页面文案」），由页面传入 */
  copy: Record<string, string>;
}

const { item, copy } = Astro.props;

const roleClass: Record<string, string> = {
  导师: 'tag-gold',
  博士后: 'tag-accent',
  博士生: 'tag-accent',
  硕士生: 'tag-muted',
  本科生: 'tag-muted',
  科研助理: 'tag-muted',
  校友: 'tag-muted',
};
---

<a class="card member-card" href={u(`/team/${item.slug}`)}>
  <span class="avatar">
    {
      item.photo ? (
        <img src={asset(item.photo)} alt={item.name} loading="lazy" />
      ) : (
        <span class="avatar-fallback" aria-hidden="true">{initials(item.name)}</span>
      )
    }
  </span>

  <span class="info">
    <span class="name-row">
      <strong class="name">{item.name}</strong>
      <span class={`tag ${roleClass[item.role] ?? 'tag-muted'}`}>{item.role}</span>
    </span>
    {item.nameEn && <span class="en">{item.nameEn}</span>}
    {item.title && <span class="meta">{item.title}</span>}
    {item.nowAt && <span class="now-at"><b>{copy.member_now_label}</b>{item.nowAt}</span>}
    {item.researchFocus && <span class="meta">{copy.member_focus_label}：{item.researchFocus}</span>}
    {
      item.interests.length > 0 && (
        <span class="chips">
          {item.interests.slice(0, 3).map((interest) => (
            <span class="tag tag-muted">{interest}</span>
          ))}
        </span>
      )
    }
  </span>
</a>

<style>
  .member-card {
    display: flex; gap: 16px; align-items: flex-start;
    padding: 20px; height: 100%; border-radius: var(--radius-sm);
  }
  .avatar {
    flex: 0 0 72px; width: 72px; height: 72px; border-radius: 14px; overflow: hidden;
    background: var(--bg-inset); display: grid; place-items: center;
    border: 1px solid var(--border);
  }
  .avatar img { width: 100%; height: 100%; object-fit: cover; }
  .avatar-fallback { font-size: 1.22rem; font-weight: 700; color: var(--accent); letter-spacing: 0.02em; }

  .info { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 3px; }
  .name-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .name { font-size: 1.05rem; font-weight: 700; color: var(--text); line-height: 1.35; }
  .en { font-size: 0.79rem; color: var(--muted); letter-spacing: 0.01em; }
  .meta { font-size: 0.84rem; color: var(--text-soft); line-height: 1.55; }
  .now-at {
    display: inline-flex; align-items: baseline; gap: 6px; margin-top: 3px;
    font-size: 0.82rem; color: var(--text); line-height: 1.5;
  }
  .now-at b {
    flex: 0 0 auto; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em;
    color: var(--gold); text-transform: uppercase;
  }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 7px; }

  .member-card:hover { text-decoration: none; }
  .member-card:hover .name { color: var(--accent); }

  /* 只有极窄屏（约 ≤360px 视口）才改为上下排布；常见手机宽度仍保持横向，避免卡片过高 */
  @media (max-width: 360px) {
    .member-card { flex-direction: column; gap: 12px; }
    .avatar { flex: none; width: 62px; height: 62px; }
  }
</style>
