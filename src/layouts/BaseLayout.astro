---
import '../styles/global.css';
import { getSite } from '../lib/content';
import { abs, stripBase, u } from '../utils/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';

interface Props {
  title?: string;
  description?: string;
  /** 详情页的末级面包屑名称（如姓名、论文标题、新闻标题） */
  crumb?: string;
  /** 额外的结构化数据（Person / NewsArticle 等），会并入同一份 @graph */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const site = await getSite();
const { title, description, crumb, schema } = Astro.props;
const metaDescription = description || site.description || site.tagline;
const pageTitle = title
  ? `${title} · ${site.name}`
  : site.nameEn
    ? `${site.name} · ${site.nameEn}`
    : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com');
const origin = canonical.origin;

// ---------------------------------------------------------------------------
// 面包屑：一级目录取自导航菜单，末级由详情页通过 crumb 传入
// ---------------------------------------------------------------------------
// 面包屑按「站内相对路径」计算，否则子路径部署下第一段会变成 lab-website
const segments = stripBase(Astro.url.pathname).split('/').filter(Boolean);
const trail: { name: string; href: string }[] = [{ name: '首页', href: u('/') }];
if (segments.length >= 1) {
  const top = `/${segments[0]}`;
  const navItem = site.nav.find((item) => item.href.replace(/\/+$/, '') === top);
  const name = navItem?.label ?? crumb ?? segments[0];
  trail.push({ name, href: u(top + '/') });
  if (segments.length >= 2 && crumb) {
    trail.push({ name: crumb, href: canonical.pathname });
  }
}

// ---------------------------------------------------------------------------
// 结构化数据：让搜索引擎正确理解这是科研机构站点，并识别站内检索入口
// ---------------------------------------------------------------------------
const organization = {
  '@type': 'ResearchOrganization',
  '@id': `${abs('/')}#organization`,
  name: site.name,
  ...(site.nameEn ? { alternateName: site.nameEn } : {}),
  ...(site.tagline ? { description: site.tagline } : {}),
  url: abs('/'),
  ...(site.affiliation ? { parentOrganization: { '@type': 'Organization', name: site.affiliation } } : {}),
  ...(site.contact.email ? { email: site.contact.email } : {}),
  ...(site.contact.phone ? { telephone: site.contact.phone } : {}),
  ...(site.contact.address
    ? {
        address: {
          '@type': 'PostalAddress',
          streetAddress: site.contact.address,
          postalCode: site.contact.postcode,
          addressCountry: 'CN',
        },
      }
    : {}),
};

const website = {
  '@type': 'WebSite',
  '@id': `${abs('/')}#website`,
  url: abs('/'),
  name: site.name,
  inLanguage: 'zh-CN',
  publisher: { '@id': `${abs('/')}#organization` },
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: abs('/?q={search_term_string}') },
    'query-input': 'required name=search_term_string',
  },
};

const graph: Record<string, unknown>[] = [organization, website];

if (trail.length > 1) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: trail.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      item: new URL(item.href, origin).toString(),
    })),
  });
}

if (schema) {
  graph.push(...(Array.isArray(schema) ? schema : [schema]));
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} · 科研新闻`} href={u('/rss.xml')} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1a56db" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- 主题需在绘制前确定，避免闪白 -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          root.setAttribute('data-theme', t);
        } catch (e) {
          root.setAttribute('data-theme', 'light');
        }
        // 仅当浏览器支持淡入动画且用户未要求减少动态效果时，才启用渐显初始状态
        try {
          var okObserve = 'IntersectionObserver' in window;
          var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (okObserve && !reduced) root.classList.add('reveal-ready');
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Header site={site} />
    <main id="main">
      <slot />
    </main>
    <Footer site={site} />

    <SearchDialog copy={site.pageCopy} />

    <button id="back-to-top" class="back-to-top" type="button" aria-label="回到页面顶部" hidden>
      <span aria-hidden="true">↑</span>
    </button>

    <script>
      // 滚动进入视口时的渐显动画
      const els = document.querySelectorAll('.reveal');
      if (els.length) {
        if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          els.forEach((el) => el.classList.add('in'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => {
                if (e.isIntersecting) {
                  e.target.classList.add('in');
                  io.unobserve(e.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
          );
          els.forEach((el) => io.observe(el));
        }
      }

      // 长页面回到顶部按钮
      const topButton = document.getElementById('back-to-top');
      if (topButton) {
        let ticking = false;
        const sync = () => {
          topButton.hidden = window.scrollY < 900;
          ticking = false;
        };
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(sync);
            }
          },
          { passive: true }
        );
        sync();
        topButton.addEventListener('click', () => {
          const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
        });
      }
    </script>
  </body>
</html>
