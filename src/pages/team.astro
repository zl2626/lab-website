---
import BaseLayout from '../layouts/BaseLayout.astro';
import MemberCard from '../components/MemberCard.astro';
import { fillCopy, getMembers, getSite, splitList } from '../lib/content';

const site = await getSite();
const copy = site.pageCopy;
const members = await getMembers();

// 分组顺序由后台「站点设置 → 成员页文案 → 身份分组顺序」控制，
// 这样实验室自定义的身份（访问学者等）也能排到自己想要的位置。
const roleOrder = splitList(copy.team_roles);

const groups = roleOrder
  .map((role) => ({ role, list: members.filter((m) => m.role === role) }))
  .filter((group) => group.list.length > 0);

// 兜底：后台没把某个身份写进顺序里时，也不要把人弄丢
const knownRoles = new Set(roleOrder);
const others = members.filter((m) => !knownRoles.has(m.role));
if (others.length > 0) groups.push({ role: copy.team_other_group, list: others });
---

<BaseLayout title={copy.team_title} description={`${site.name}的团队成员`}>
  <div class="page-head">
    <div class="container">
      <h1>{copy.team_title}</h1>
      <p>{fillCopy(copy.team_intro, { count: members.length })}</p>
    </div>
  </div>

  {
    groups.map((group) => (
      <section class="section-tight container group">
        <div class="group-head">
          <h2>{group.role}</h2>
          <span class="count">{group.list.length}</span>
        </div>
        <div class="member-list">
          {group.list.map((item) => (
            <MemberCard item={item} copy={copy} />
          ))}
        </div>
      </section>
    ))
  }

  {
    members.length === 0 && (
      <section class="section container">
        <p class="muted">{copy.team_empty}</p>
      </section>
    )
  }
</BaseLayout>

<style>
  .group { padding-top: 52px; }
  .group-head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 22px; }
  .group-head h2 { margin: 0; }
  /* 自适应列宽：桌面最多 3 列，避免卡片过窄导致文字频繁换行 */
  .member-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr)); gap: 16px; }
  .count {
    font-size: 0.8rem; font-weight: 700; color: var(--accent);
    background: var(--accent-soft); padding: 2px 10px; border-radius: 999px;
  }
</style>
