---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationItem from '../../components/PublicationItem.astro';
import { getMembers, getPublications, getResearch, getSite } from '../../lib/content';
import { abs, asset, u } from '../../utils/url';
import { initials } from '../../utils/format';
import { buildAuthorIndex, publicationsByMember } from '../../utils/authors.mjs';

export async function getStaticPaths() {
  const members = await getMembers();
  return members.map((item) => ({ params: { id: item.slug }, props: { item } }));
}

// Astro 开发服务器会缓存 getStaticPaths 返回的 props：后台改完内容后，
// 已经渲染过的详情页不会跟着刷新（列表页是实时的，详情页却停在旧数据）。
// 开发时按 slug 重新读一次最新内容，保证「后台改 → 本地详情页立刻可见」；
// 生产构建仍然走 getStaticPaths，静态产物不受影响。
let item = Astro.props.item;
if (import.meta.env.DEV) {
  item = (await getMembers()).find((entry) => entry.slug === Astro.params.id) ?? item;
}

// 研究方向标题 -> slug，用于把成员的「所在研究方向」变成可点击的链接
const areaSlug = new Map((await getResearch()).map((area) => [area.title, area.slug]));

// 结构化数据：让搜索引擎把这位成员识别为一个研究者（而不是普通页面）
const site = await getSite();
const copy = site.pageCopy;
const origin = (Astro.site ?? new URL('https://example.com')).origin;
const portrait = item.photo ? new URL(asset(item.photo), origin).toString() : '';

// 这位成员参与过的成果：按作者署名与成员的英文名/中文名精确匹配
const [allMembers, allPublications] = await Promise.all([getMembers(), getPublications()]);
const ownPublications = publicationsByMember(allPublications, item);
const memberByAuthor = buildAuthorIndex(allMembers);

const linkItems = [
  { key: 'homepage', label: copy.member_link_homepage },
  { key: 'scholar', label: copy.member_link_scholar },
  { key: 'github', label: copy.member_link_github },
  { key: 'dblp', label: copy.member_link_dblp },
  { key: 'orcid', label: copy.member_link_orcid },
].filter((l) => Boolean(item.links[l.key]));

const personSchema = {
  '@type': 'Person',
  '@id': `${abs(`/team/${item.slug}/`)}#person`,
  name: item.name,
  ...(item.nameEn ? { alternateName: item.nameEn } : {}),
  url: abs(`/team/${item.slug}/`),
  ...(item.title ? { jobTitle: item.title } : {}),
  ...(item.email ? { email: `mailto:${item.email}` } : {}),
  ...(portrait ? { image: portrait } : {}),
  ...(item.researchFocus ? { description: item.researchFocus } : {}),
  ...(item.interests.length ? { knowsAbout: item.interests } : {}),
  ...(site.affiliation ? { affiliation: { '@type': 'Organization', name: site.affiliation } } : {}),
  ...(Object.values(item.links).length ? { sameAs: Object.values(item.links) } : {}),
};
---

<BaseLayout title={item.name} description={`${item.name} · ${item.role}`} crumb={item.name} schema={personSchema}>
  <section class="section-detail container">
    <p class="crumb"><a href={u('/team')}>{copy.team_title}</a> / {item.name}</p>

    <div class="profile">
      <div class="avatar">
        {
          item.photo ? (
            <img src={asset(item.photo)} alt={item.name} />
          ) : (
            <span class="avatar-fallback">{initials(item.name)}</span>
          )
        }
      </div>

      <div class="intro">
        <h1>{item.name}</h1>
        <div class="row meta">
          <span class="tag tag-gold">{item.role}</span>
          {item.title && <span class="muted small">{item.title}</span>}
          {item.joinYear && <span class="muted small">{item.joinYear} {copy.member_join_year_suffix}</span>}
        </div>
        {item.nameEn && <p class="en">{item.nameEn}</p>}
        {item.nowAt && <p class="now-at"><span class="now-at-label">{copy.member_now_label}</span>{item.nowAt}</p>}
        {item.researchFocus && <p class="small">{copy.member_focus_label}：{item.researchFocus}</p>}

        {
          item.areas.length > 0 && (
            <div class="block">
              <h4>{copy.member_areas_title}</h4>
              <div class="row tags">
                {item.areas.map((areaTitle) =>
                  areaSlug.get(areaTitle) ? (
                    <a class="tag" href={u(`/research/${areaSlug.get(areaTitle)}/`)}>{areaTitle}</a>
                  ) : (
                    <span class="tag tag-muted">{areaTitle}</span>
                  )
                )}
              </div>
            </div>
          )
        }

        {item.hobbies.length > 0 && <div class="block"><h4>{copy.member_hobbies_title}</h4><div class="row tags">{item.hobbies.map((h) => <span class="tag tag-muted">{h}</span>)}</div></div>}
        {item.achievementSummary && <div class="block"><h4>{copy.member_achievements_title}</h4><p>{item.achievementSummary}</p></div>}
        {item.email && <p class="small">{copy.member_email_label}：<a href={`mailto:${item.email}`}>{item.email}</a></p>}

        {
          item.interests.length > 0 && (
            <div class="block">
              <h4>{copy.member_interests_title}</h4>
              <div class="row tags">
                {item.interests.map((i) => (
                  <span class="tag tag-muted">{i}</span>
                ))}
              </div>
            </div>
          )
        }

        {
          linkItems.length > 0 && (
            <div class="block">
              <h4>{copy.member_links_title}</h4>
              <div class="row links">
                {linkItems.map((l) => (
                  <a class="btn btn-ghost sm" href={item.links[l.key]} target="_blank" rel="noopener">
                    {l.label} ↗
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>

    {
      item.bioHtml && (
        <>
          <hr class="divider" style="margin:38px 0" />
          <div class="prose" set:html={item.bioHtml} />
        </>
      )
    }

    {
      ownPublications.length > 0 && (
        <>
          <hr class="divider" style="margin:38px 0 0" />
          <section class="member-pubs">
            <div class="member-pubs-head">
              <h2>{copy.member_publications_title}</h2>
              <a class="more-link" href={u('/publications')}>
                {copy.member_publications_more} <span aria-hidden="true">→</span>
              </a>
            </div>
            <div class="pub-list">
              {ownPublications.map((pub) => (
                <PublicationItem item={pub} copy={copy} memberByAuthor={memberByAuthor} />
              ))}
            </div>
          </section>
        </>
      )
    }
  </section>
</BaseLayout>

<style>
  .crumb { font-size: 0.85rem; color: var(--muted); margin-bottom: 22px; }
  .profile { display: grid; grid-template-columns: 190px 1fr; gap: 34px; align-items: start; }
  .avatar {
    width: 190px; height: 190px; border-radius: 18px; overflow: hidden;
    background: var(--bg-inset); display: grid; place-items: center; border: 1px solid var(--border);
  }
  .avatar img { width: 100%; height: 100%; object-fit: cover; }
  .avatar-fallback { font-size: 2.6rem; font-weight: 700; color: var(--accent); }
  .intro h1 { margin-bottom: 0.3em; }
  .meta { gap: 10px; margin-bottom: 10px; }
  .en { color: var(--muted); margin: 0 0 0.6em; }
  /* 校友去向：用一条左侧色条突出，比普通正文更容易被看到 */
  .now-at {
    display: flex; align-items: baseline; gap: 8px; margin: 0 0 .7em;
    padding: 8px 14px; border-left: 3px solid var(--gold);
    background: var(--bg-soft); border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: .92rem; color: var(--text);
  }
  .now-at-label {
    flex: 0 0 auto; font-size: .72rem; font-weight: 700; letter-spacing: .1em;
    text-transform: uppercase; color: var(--gold);
  }
  .tags a.tag { text-decoration: none !important; }
  .tags a.tag:hover { background: var(--accent); color: var(--on-accent); }
  .block { margin-top: 20px; }

  /* 参与过的成果：复用成果页的条目样式，保持两处观感一致 */
  .member-pubs { margin-top: 34px; }
  .member-pubs-head {
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    margin-bottom: 6px;
  }
  .member-pubs-head h2 {
    display: flex; align-items: center; gap: 10px;
    font-size: 1.12rem; font-weight: 700; margin: 0;
  }
  .member-pubs-head h2::before {
    content: ''; width: 3px; height: 1.05em;
    background: var(--accent); border-radius: 2px;
  }
  .member-pubs .pub-list { border-top: 1px solid var(--border); margin-top: 16px; }
  @media (max-width: 560px) {
    .member-pubs-head { flex-wrap: wrap; gap: 10px; }
  }
  .block h4 {
    font-size: 0.82rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--muted); margin-bottom: 10px;
  }
  .tags { gap: 7px; }
  .links { gap: 10px; }
  .btn.sm { padding: 7px 14px; font-size: 0.85rem; }
  @media (max-width: 640px) {
    .profile { grid-template-columns: 1fr; gap: 22px; }
    .avatar { width: 132px; height: 132px; }
  }
</style>
