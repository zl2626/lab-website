---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getResearch, getSite } from '../lib/content';
import { u } from '../utils/url';

const site = await getSite();
const copy = site.pageCopy;
const { openings, contact } = site;
const research = await getResearch();

// 招生信息不完整时，仍然给出联系入口，不要让页面变成死路
const hasOpenings = openings.enabled && Boolean(openings.title || openings.text || openings.detailsHtml);
const applyEmail = openings.email || contact.email;
---

<BaseLayout title={copy.join_title} description={copy.join_intro} crumb={copy.join_title}>
  <div class="page-head">
    <div class="container">
      <h1>{copy.join_title}</h1>
      <p>{copy.join_intro}</p>
    </div>
  </div>

  <section class="section container">
    <div class="join-layout">
      <div class="join-main">
        {
          hasOpenings ? (
            <>
              {openings.title && <h2 class="join-heading">{openings.title}</h2>}
              {openings.text && <p class="join-lead">{openings.text}</p>}
              {openings.detailsHtml && <div class="prose join-details" set:html={openings.detailsHtml} />}
            </>
          ) : (
            <p class="join-lead">{copy.join_empty}</p>
          )
        }

        {
          applyEmail && (
            <a
              class="btn btn-primary join-apply"
              href={`mailto:${applyEmail}?subject=${encodeURIComponent(copy.contact_apply_subject)}`}
            >
              {copy.contact_apply_label}
            </a>
          )
        }
      </div>

      <aside class="join-side">
        <div class="card side-card">
          <h3>{copy.join_directions_title}</h3>
          <p class="small muted">{copy.join_directions_hint}</p>
          <ul class="side-list">
            {research.map((item) => (
              <li>
                <a href={u(`/research/${item.slug}/`)}>
                  <span aria-hidden="true">{item.icon}</span>
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="card side-card">
          <h3>{copy.join_contact_title}</h3>
          <ul class="side-contact">
            {applyEmail && <li>{copy.contact_email_label}：<a href={`mailto:${applyEmail}`}>{applyEmail}</a></li>}
            {contact.phone && <li>{copy.contact_phone_label}：{contact.phone}</li>}
            {contact.address && (
              <li>
                {copy.contact_address_label}：{contact.address}
                {contact.postcode ? `，${copy.contact_postcode_prefix} ${contact.postcode}` : ''}
              </li>
            )}
          </ul>
          <a class="more-link side-more" href={u('/contact')}>
            {copy.contact_title} <span aria-hidden="true">→</span>
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  /* 正文 + 侧栏：侧栏承载「方向」与「联系方式」，方便申请者直接行动 */
  .join-layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 44px; align-items: start; }

  .join-heading { font-size: clamp(1.3rem, 2.4vw, 1.75rem); margin-bottom: .4em; }
  .join-lead { font-size: 1.02rem; line-height: 1.9; margin-bottom: 1em; }
  .join-details { max-width: 72ch; }
  .join-details > :first-child { margin-top: 0; }
  .join-details h2 { font-size: 1.1rem; margin: 1.8em 0 .5em; }
  .join-details h2:first-of-type { margin-top: 0; }
  .join-details ul, .join-details ol { margin: 0 0 1em; }
  .join-apply { margin-top: 26px; }

  .join-side { display: flex; flex-direction: column; gap: 16px; position: sticky; top: calc(var(--header-h) + 20px); }
  .side-card { padding: 20px; }
  .side-card h3 { font-size: 0.95rem; margin-bottom: .5em; }
  .side-card p { margin: 0 0 .9em; font-size: .82rem; line-height: 1.6; }
  .side-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .side-list li + li { border-top: 1px solid var(--border); }
  .side-list a {
    display: flex; align-items: center; gap: 8px; padding: 9px 0;
    font-size: .9rem; font-weight: 600; color: var(--text);
  }
  .side-list a:hover { color: var(--accent); text-decoration: none; }
  .side-contact { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .side-contact li { font-size: .84rem; color: var(--text-soft); line-height: 1.6; }
  .side-more { margin-top: 16px; padding: 7px 16px; font-size: .82rem; gap: 10px; }

  @media (max-width: 900px) {
    .join-layout { grid-template-columns: 1fr; gap: 32px; }
    .join-side { position: static; }
  }
</style>
