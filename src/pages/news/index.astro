---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getNews, getSite } from '../../lib/content';
import { groupByYear } from '../../utils/format';

const site = await getSite();
const copy = site.pageCopy;
const news = await getNews();

const years = groupByYear(news, (item) => Number(item.date.slice(0, 4)) || 0);
const allTags = [...new Set(news.flatMap((item) => item.tags))].sort();

// 分组的条数文案在筛选时由脚本更新，把单位与空状态文案下发给客户端
const clientCopy = { countUnit: copy.news_count_unit, emptyTag: copy.news_empty_tag };
---

<BaseLayout title={copy.news_title} description={`${site.name}的科研新闻与动态`}>
  <div class="page-head">
    <div class="container">
      <h1>{copy.news_title}</h1>
      <p>{copy.news_intro}</p>
      {
        allTags.length > 0 && (
          <div class="row filters" id="tag-filters">
            <button class="chip active" aria-pressed="true">{copy.news_tag_all}</button>
            {allTags.map((t) => (
              <button class="chip" data-tag={t} aria-pressed="false">#{t}</button>
            ))}
          </div>
        )
      }
    </div>
  </div>

  <section class="section container">
    {
      years.map(({ year, items }) => (
        <div class="year-block">
          <div class="year-head">
            <h2>{year}</h2>
            <span class="muted small year-count">{items.length} {copy.news_count_unit}</span>
          </div>
          <div class="grid grid-3">
            {items.map((item, i) => (
              <div class="news-cell" data-tags={JSON.stringify(item.tags)}>
                <NewsCard item={item} index={i} copy={copy} />
              </div>
            ))}
          </div>
        </div>
      ))
    }
    {news.length === 0 && <p class="muted">{copy.news_empty}</p>}
    <p id="no-result" class="muted" hidden>{copy.news_empty_tag}</p>
  </section>

  <script type="application/json" id="news-client-copy" set:html={JSON.stringify(clientCopy)} />

<script>
  import { matchesNewsTag } from '../../utils/news-filter.mjs';

  const filters = document.getElementById('tag-filters');
  const cells = Array.from(document.querySelectorAll<HTMLElement>('.news-cell'));
  const empty = document.getElementById('no-result');

  // 文案由页面下发，避免把界面文字写死在脚本里
  const clientCopy = JSON.parse(document.getElementById('news-client-copy')?.textContent || '{}') as {
    countUnit?: string;
  };
  const countUnit = clientCopy.countUnit || '条';

  filters?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip');
    if (!btn) return;
    filters.querySelectorAll('.chip').forEach((c) => {
      c.classList.toggle('active', c === btn);
      c.setAttribute('aria-pressed', String(c === btn));
    });

    const tag = btn.dataset.tag ?? null;
    let visible = 0;
    cells.forEach((cell) => {
      const show = matchesNewsTag(cell.dataset.tags || '[]', tag);
      cell.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    document.querySelectorAll<HTMLElement>('.year-block').forEach((block) => {
      const total = Array.from(block.querySelectorAll<HTMLElement>('.news-cell'))
        .filter((cell) => cell.style.display !== 'none').length;
      block.hidden = total === 0;
      block.querySelector('.year-count')!.textContent = `${total} ${countUnit}`;
    });
    if (empty) empty.hidden = visible > 0;
  });
</script>
</BaseLayout>

<style>
  .filters { gap: 8px; margin-top: 22px; }
  .chip {
    padding: 6px 14px; border-radius: 999px; font-size: 0.84rem; font-weight: 600; cursor: pointer;
    border: 1px solid var(--border); background: var(--bg); color: var(--text-soft); transition: 0.16s ease;
  }
  .chip:hover { border-color: var(--border-strong); }
  .chip.active { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .year-block { margin-bottom: 46px; }
  .year-head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 20px; }
  .year-head h2 { margin: 0; font-size: 1.5rem; }
  .news-cell { display: contents; }
</style>

