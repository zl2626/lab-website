---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNews, getSite } from '../../lib/content';
import { asset, u } from '../../utils/url';
import { formatDate } from '../../utils/format';

import { shouldShowToc, withHeadingAnchors } from '../../utils/toc.mjs';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((item) => ({ params: { id: item.slug }, props: { item } }));
}

const { item } = Astro.props;

// 列表已按日期倒序，据此找出相邻的两条新闻
const all = await getNews();
const index = all.findIndex((n) => n.slug === item.slug);
const older = index >= 0 && index < all.length - 1 ? all[index + 1] : null;
const newer = index > 0 ? all[index - 1] : null;

// 正文标题补锚点，并收集目录
const { html: bodyHtml, headings } = withHeadingAnchors(item.bodyHtml);

// 结构化数据：帮助搜索引擎把它当作一条新闻而不是普通静态页
const site = await getSite();
const copy = site.pageCopy;
const origin = (Astro.site ?? new URL('https://example.com')).origin;
const cover = item.cover ? new URL(asset(item.cover), origin).toString() : '';
const newsSchema = {
  '@type': 'NewsArticle',
  '@id': `${origin}${u(`/news/${item.slug}/`)}#article`,
  headline: item.title,
  datePublished: item.date,
  dateModified: item.date,
  url: new URL(u(`/news/${item.slug}/`), origin).toString(),
  inLanguage: 'zh-CN',
  ...(item.summary ? { description: item.summary } : {}),
  ...(cover ? { image: [cover] } : {}),
  ...(item.tags.length ? { keywords: item.tags.join(', ') } : {}),
  articleSection: '科研新闻',
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@id': `${origin}/#organization` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(u(`/news/${item.slug}/`), origin).toString() },
};
---

<BaseLayout title={item.title} description={item.summary || undefined} crumb={item.title} schema={newsSchema}>
  <article class="section-detail container-narrow">
    <p class="crumb"><a href={u('/news')}>{copy.news_title}</a></p>
    <header>
      <div class="row meta">
        <time datetime={item.date}>{formatDate(item.date)}</time>
        {item.pinned && <span class="tag tag-gold">{copy.news_pinned}</span>}
        {item.tags.map((t) => <span class="tag tag-muted">#{t}</span>)}
      </div>
      <h1>{item.title}</h1>
    </header>

    {item.cover && <img class="cover" src={asset(item.cover)} alt={item.title} />}

    {
      shouldShowToc(headings) && (
        <nav class="toc" aria-labelledby="toc-title">
          <p class="toc-label" id="toc-title">{copy.toc_title}</p>
          <ol class="toc-list">
            {headings.map((heading) => (
              <li class={`toc-item lvl-${heading.level}`}>
                <a href={`#${heading.id}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <!-- 正文由后端 / 本地 Markdown 渲染成 HTML 后注入 -->
    <div class="prose" set:html={bodyHtml} />

    <nav class="pager" aria-label="新闻翻页">
      {
        older ? (
          <a href={u(`/news/${older.slug}`)}>
            <span class="dir">← {copy.news_prev}</span>
            <span class="t">{older.title}</span>
          </a>
        ) : (
          <span class="spacer" />
        )
      }
      {
        newer ? (
          <a class="next" href={u(`/news/${newer.slug}`)}>
            <span class="dir">{copy.news_next} →</span>
            <span class="t">{newer.title}</span>
          </a>
        ) : (
          <span class="spacer" />
        )
      }
    </nav>

    <hr class="divider" style="margin:34px 0 22px" />
    <a class="btn btn-ghost" href={u('/news')}>← {copy.news_back}</a>
  </article>
</BaseLayout>

<style>
  .crumb { font-size: 0.85rem; color: var(--muted); margin-bottom: 18px; }
  .meta { gap: 10px; margin-bottom: 14px; }
  .meta time { font-size: 0.86rem; color: var(--muted); }
  h1 { margin-bottom: 0.6em; }
  /* 封面图用固定比例占位，避免图片加载后把正文顶下去（布局抖动） */
  .cover {
    width: 100%; aspect-ratio: 16 / 9; object-fit: cover;
    border-radius: var(--radius); margin: 8px 0 28px; border: 1px solid var(--border);
  }
</style>
