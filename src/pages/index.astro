---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadContent } from '../lib/content';
import { asset, u } from '../utils/url';
import { formatDate } from '../utils/format';
const { site, homeSlides, research, members, news, publications: pubs } = await loadContent();
const copy = site.pageCopy;

// 后台配置了「首页轮播」就用配置的内容；没配置时回退到「团队合照 + 前两个研究方向」的自动拼接，
// 这样老站点不配也能正常显示。
const fallbackSlides = [
  { title: site.name, titleEn: site.nameEn, summary: site.tagline, image: site.groupPhoto, link: '/team', linkLabel: copy.home_team_action },
  ...research.slice(0, 2).map((item) => ({ title: item.title, titleEn: item.titleEn, summary: item.summary, image: item.cover, link: `/research/${item.slug}`, linkLabel: copy.home_research_action })),
];
const slides = homeSlides.length ? homeSlides : fallbackSlides;

const stats = [
  { value: research.length, label: copy.home_stat_research },
  { value: members.length, label: copy.home_stat_members },
  { value: pubs.length, label: copy.home_stat_publications },
];

/** 把后台填的条数收进合理范围：填错也不至于把首页撑爆或什么都不显示 */
function clampCount(value: string, fallback: number): number {
  const parsed = Number.parseInt(String(value ?? '').trim(), 10);
  if (!Number.isFinite(parsed)) return fallback;
  return Math.min(Math.max(parsed, 1), 12);
}

// 首页「代表性成果」：条数可在后台调；优先精选，不足时按年份从新到旧补齐
const pubLimit = clampCount(copy.home_publications_count, 4);
const newsLimit = clampCount(copy.home_news_count, 4);

const highlights = pubs.filter((p) => p.highlight);
const homePubs = [...highlights, ...pubs.filter((p) => !p.highlight)].slice(0, pubLimit);
---

<BaseLayout image={site.groupPhoto}>
  <section
    class="home-banner"
    id="home-carousel"
    role="region"
    aria-label="实验室研究展示"
    aria-roledescription="轮播"
    tabindex="0"
  >
    {slides.map((slide, index) => (
      <article
        class="banner-slide"
        hidden={index !== 0}
        role="group"
        aria-roledescription="幻灯片"
        aria-label={`第 ${index + 1} 张，共 ${slides.length} 张`}
      >
        {slide.image && <img class="banner-image" src={asset(slide.image)} alt="" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} />}
        <div class="banner-decoration" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="container banner-copy">
          <p class="banner-affil">{site.affiliation}</p>
          {index === 0 ? <h1>{slide.title}</h1> : <h2 class="banner-title">{slide.title}</h2>}
          {slide.titleEn && <p class="banner-english">{slide.titleEn}</p>}
          {slide.summary && <p class="banner-summary">{slide.summary}</p>}
          {slide.link && (
            <a class="banner-link" href={u(slide.link)}>
              {slide.linkLabel || copy.home_slide_more} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </article>
    ))}

    <div class="container banner-controls" hidden>
      <button type="button" class="banner-arrow" id="slide-prev" aria-label="上一张">
        <span aria-hidden="true">←</span>
      </button>

      <div class="banner-dots" role="group" aria-label="选择幻灯片">
        {slides.map((slide, index) => (
          <button
            type="button"
            class="banner-dot"
            data-index={index}
            aria-current={index === 0 ? 'true' : 'false'}
            aria-label={`第 ${index + 1} 张：${slide.title}`}
          />
        ))}
      </div>

      <p class="banner-count" aria-live="polite">
        <span id="slide-current">01</span><i aria-hidden="true">/</i>{String(slides.length).padStart(2, '0')}
      </p>

      <button type="button" class="banner-arrow" id="slide-next" aria-label="下一张">
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </section>

  <section class="home-section home-research">
    <div class="container">
      <div class="home-heading">
        <div>
          <h2>{copy.home_research_title}</h2>
          <span>{copy.home_research_label}</span>
        </div>
        <a class="more-link" href={u('/research')}>{copy.home_research_more} <span aria-hidden="true">→</span></a>
      </div>
      {copy.home_research_intro && <p class="home-lead">{copy.home_research_intro}</p>}
      <div class="research-grid">
        {research.map((item, index) => (
          <a class="research-tile" href={u(`/research/${item.slug}`)}>
            {item.cover && <img src={asset(item.cover)} alt="" loading="lazy" />}
            <span class="research-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <span class="research-english">{item.titleEn}</span>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
            </div>
            <span class="research-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      {research.length === 0 && <p>{copy.home_research_empty}</p>}
    </div>
  </section>

  {
    homePubs.length > 0 && (
      <section class="home-section home-publications">
        <div class="container">
          <div class="home-heading">
            <div>
              <h2>{copy.home_publications_title}</h2>
              <span>{copy.home_publications_label}</span>
            </div>
            <a class="more-link" href={u('/publications')}>{copy.home_publications_more} <span aria-hidden="true">→</span></a>
          </div>
          {copy.home_publications_intro && <p class="home-lead">{copy.home_publications_intro}</p>}
          <div class="pub-highlight-grid">
            {homePubs.map((item) => (
              <article class="pub-highlight">
                <div class="ph-top">
                  <span class="ph-year">{item.year}</span>
                  <span class="tag">{item.type}</span>
                  {item.venueShort && <span class="tag tag-muted">{item.venueShort}</span>}
                  {item.highlight && <span class="tag tag-gold">{copy.pub_highlight_tag}</span>}
                </div>
                <h3>{item.title}</h3>
                {item.authors.length > 0 && <p class="ph-authors">{item.authors.join('，')}</p>}
                {item.venue && <p class="ph-venue">{item.venue}</p>}
                <div class="ph-links">
                  {item.link && <a href={item.link} target="_blank" rel="noopener">{copy.pub_link_original} ↗</a>}
                  {item.pdf && <a href={item.pdf} target="_blank" rel="noopener">{copy.pub_link_pdf} ↗</a>}
                  {item.code && <a href={item.code} target="_blank" rel="noopener">{copy.pub_link_code} ↗</a>}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="home-section home-news">
    <div class="container">
      <div class="home-heading">
        <div>
          <h2>{copy.home_news_title}</h2>
          <span>{copy.home_news_label}</span>
        </div>
        <a class="more-link" href={u('/news')}>{copy.home_news_action} <span aria-hidden="true">→</span></a>
      </div>
      {copy.home_news_intro && <p class="home-lead">{copy.home_news_intro}</p>}
      <div class="news-grid">
        {news.slice(0, newsLimit).map((item) => (
          <a class="news-tile" href={u(`/news/${item.slug}`)}>
            <div class="news-visual">
              {item.cover ? (
                <img src={asset(item.cover)} alt="" loading="lazy" />
              ) : (
                <div class="news-placeholder">
                  <span>{item.tags[0] || copy.news_default_tag}</span>
                  <strong>{formatDate(item.date).slice(0, 4)}</strong>
                  <span>{site.abbr} · {copy.home_news_meta}</span>
                </div>
              )}
            </div>
            <div class="news-text">
              <h3>{item.title}</h3>
              <div class="news-bottom">
                <time datetime={item.date}>{formatDate(item.date)}</time>
                <span aria-hidden="true">↗</span>
              </div>
            </div>
          </a>
        ))}
      </div>
      {news.length === 0 && <p>{copy.home_news_empty}</p>}
    </div>
  </section>

  <section class="home-section home-about">
    <div class="container about-grid">
      <div class="about-copy">
        <div class="home-heading"><div><h2>{copy.home_about_title}</h2><span>{copy.home_about_label}</span></div></div>
        <p class="about-description">{site.description || site.tagline}</p>
        <a class="more-link" href={u('/team')}>{copy.home_team_action} <span aria-hidden="true">→</span></a>
        <div class="about-stats">{stats.map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}</div>
      </div>
      <a class="about-visual" href={u('/team')} aria-label={copy.home_team_action}>
        {site.groupPhoto ? <img src={asset(site.groupPhoto)} alt={`${site.name}团队合影`} loading="lazy" /> : <div class="about-placeholder"><span>{site.abbr}</span><strong>{site.name}</strong><p>{site.nameEn}</p></div>}
        <span class="about-caption">{copy.home_team_action} <span aria-hidden="true">↗</span></span>
      </a>
    </div>
  </section>

  {
    site.openings.enabled && (
      <section class="home-join">
        <div class="container join-inner">
          <div>
            <h2>{site.openings.title}</h2>
            <p>{site.openings.text}</p>
          </div>
          <a class="more-link" href={u('/join')}>{copy.home_join_action} <span aria-hidden="true">→</span></a>
        </div>
      </section>
    )
  }

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.banner-slide'));
  const carousel = document.getElementById('home-carousel');
  const controls = document.querySelector<HTMLElement>('.banner-controls');
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.banner-dot'));
  const counter = document.getElementById('slide-current');
  const AUTOPLAY_MS = 7000;
  let current = 0;
  let timer: number | undefined;

  function show(index: number) {
    current = (index + slides.length) % slides.length;
    slides.forEach((slide, i) => { slide.hidden = i !== current; });
    dots.forEach((dot, i) => { dot.setAttribute('aria-current', String(i === current)); });
    if (counter) counter.textContent = String(current + 1).padStart(2, '0');
  }

  function step(offset: number) {
    show(current + offset);
  }

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  function stopAutoplay() {
    if (timer !== undefined) { window.clearInterval(timer); timer = undefined; }
  }
  function startAutoplay() {
    stopAutoplay();
    if (slides.length > 1 && !reduced.matches && !document.hidden) {
      timer = window.setInterval(() => step(1), AUTOPLAY_MS);
    }
  }

  if (slides.length > 1 && carousel) {
    if (controls) controls.hidden = false;
    document.getElementById('slide-prev')?.addEventListener('click', () => { step(-1); startAutoplay(); });
    document.getElementById('slide-next')?.addEventListener('click', () => { step(1); startAutoplay(); });
    dots.forEach((dot) => dot.addEventListener('click', () => {
      show(Number(dot.dataset.index || 0));
      startAutoplay();
    }));

    carousel.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') { step(-1); startAutoplay(); event.preventDefault(); }
      else if (event.key === 'ArrowRight') { step(1); startAutoplay(); event.preventDefault(); }
    });

    // 鼠标悬停或键盘聚焦时暂停自动播放，离开后恢复
    carousel.addEventListener('mouseenter', stopAutoplay);
    carousel.addEventListener('mouseleave', startAutoplay);
    carousel.addEventListener('focusin', stopAutoplay);
    carousel.addEventListener('focusout', startAutoplay);
    document.addEventListener('visibilitychange', () => (document.hidden ? stopAutoplay() : startAutoplay()));

    // 标签页不可见或用户开启减少动效时，不要空转定时器
    startAutoplay();
  }
</script>
</BaseLayout>

<style>
/* ---------- 首屏轮播 ---------- */
.home-banner{position:relative;background:#163751;color:#fff;overflow:hidden}
.home-banner:focus-visible{outline-offset:-4px}
.banner-slide{position:relative;min-height:600px;display:flex;align-items:center;isolation:isolate;background:linear-gradient(120deg,#153047,#2d6072)}
.banner-slide:nth-child(2){background:linear-gradient(120deg,#253b50,#586b7a)}
.banner-slide:nth-child(3){background:linear-gradient(120deg,#283d51,#456c69)}
.banner-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}
.banner-slide:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(7,24,38,.72),rgba(7,24,38,.12));z-index:-1}
.banner-decoration{position:absolute;right:8%;top:22%;width:320px;aspect-ratio:1;opacity:.14;pointer-events:none;z-index:-1}
.banner-decoration span{position:absolute;inset:0;border:1px solid #fff;border-radius:50%}
.banner-decoration span:nth-child(2){inset:15%;border-style:dashed}
.banner-decoration span:nth-child(3){inset:30%}
.banner-copy{padding-top:150px;padding-bottom:130px}
.banner-affil{font-size:.9rem;letter-spacing:.08em;color:#d5e2eb}
/* 首屏标题：第一张用 h1（页面主标题），其余用 h2，保证每页只有一个 h1 */
.banner-copy h1,.banner-copy .banner-title{color:#fff;font-weight:600;font-size:clamp(2rem,4vw,3.5rem);max-width:18em;text-wrap:balance;line-height:1.32;margin:0 0 .5em}
.banner-copy .banner-title{margin-bottom:.5em}
.banner-english{color:#dfebf0;font-size:1.05rem;margin-bottom:.6em}
.banner-summary{color:#e2ebef;max-width:40em;font-size:1.05rem}
.banner-link{display:inline-flex;gap:30px;align-items:center;color:#fff;border-bottom:1px solid #a3bbc8;padding:10px 0;margin-top:10px;font-size:.95rem}
.banner-link:hover{color:#fff;border-bottom-color:#fff;text-decoration:none}
.banner-link:focus-visible{outline-color:#fff}

.banner-controls{position:absolute;bottom:30px;left:0;right:0;display:flex;align-items:center;gap:18px}
.banner-arrow{
  width:44px;height:44px;flex:0 0 44px;border:1px solid rgba(255,255,255,.42);border-radius:50%;
  background:transparent;color:#fff;font-size:1.05rem;cursor:pointer;transition:.18s ease;
  display:grid;place-items:center;
}
.banner-arrow:hover{background:rgba(255,255,255,.16);border-color:#fff}
.banner-arrow:focus-visible{outline-color:#fff}
.banner-dots{display:flex;align-items:center;gap:9px;margin-left:auto}
.banner-dot{
  width:26px;height:3px;padding:0;border:0;border-radius:3px;cursor:pointer;
  background:rgba(255,255,255,.35);transition:.2s ease;
}
.banner-dot:hover{background:rgba(255,255,255,.65)}
.banner-dot[aria-current='true']{background:#fff;width:40px}
.banner-dot:focus-visible{outline-color:#fff;outline-offset:4px}
.banner-count{display:flex;align-items:center;gap:4px;font-size:.88rem;font-variant-numeric:tabular-nums;color:#dfeaf1;margin:0}
.banner-count i{font-style:normal;opacity:.55}

/* ---------- 栏目标题 ---------- */
.home-section{padding:72px 0}
.home-heading{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:20px}
.home-heading h2{position:relative;font-size:clamp(1.7rem,3vw,2.25rem);font-weight:600;margin:0 0 4px;z-index:0}
.home-heading h2:before{content:'';position:absolute;left:-12px;top:-6px;width:38px;height:38px;border-radius:50%;background:var(--accent-soft);z-index:-1}
.home-heading>div>span{color:var(--muted);letter-spacing:.05em;font-size:.9rem}
.home-lead{max-width:60ch;margin:0 0 34px;font-size:.98rem}

/* ---------- 研究方向 ---------- */
.research-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(210px,100%),1fr));gap:16px}
.research-tile{position:relative;isolation:isolate;background:#24475c;color:#fff;min-height:290px;padding:26px 22px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;transition:.2s ease}
.research-tile:nth-child(even){background:#3a5966}
.research-tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}
.research-tile:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,rgba(7,24,36,.9),rgba(7,24,36,.12));z-index:-1}
.research-number{font-family:var(--font-serif);font-size:2rem;color:#b8ced9;line-height:1}
.research-english{font-size:.74rem;color:#cbdde5;letter-spacing:.02em}
.research-tile h3{color:#fff;font-size:1.1rem;margin-top:6px}
.research-tile p{font-size:.82rem;color:#d3e1e7;margin:0;line-height:1.7}
.research-arrow{align-self:flex-end;font-size:1.3rem;transition:transform .2s ease}
.research-tile:hover{transform:translateY(-3px);text-decoration:none}
.research-tile:hover .research-arrow{transform:translate(2px,-2px)}
.research-tile:focus-visible{outline-offset:3px}

/* ---------- 代表性成果 ---------- */
.home-publications{background:var(--bg-soft)}
.pub-highlight-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(410px,100%),1fr));gap:18px}
.pub-highlight{
  background:var(--bg);border:1px solid var(--border);border-radius:var(--radius);
  padding:22px 22px 20px;display:flex;flex-direction:column;transition:.2s ease;
}
.pub-highlight:hover{border-color:var(--border-strong);box-shadow:var(--shadow);transform:translateY(-2px)}
.ph-top{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-bottom:12px}
.ph-year{font-family:var(--font-serif);font-size:1.32rem;color:var(--accent);line-height:1}
.pub-highlight h3{font-size:1.02rem;line-height:1.5;margin:0 0 .5em;font-weight:650}
.ph-authors{font-size:.85rem;color:var(--text-soft);margin:0 0 .3em}
.ph-venue{font-size:.82rem;color:var(--muted);font-style:italic;margin:0 0 .9em}
.ph-links{display:flex;flex-wrap:wrap;gap:14px;margin-top:auto}
.ph-links a{font-size:.83rem;font-weight:600}

/* ---------- 新闻 ---------- */
.news-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}
.news-tile{display:flex;flex-direction:column;background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);transition:.2s ease}
.news-tile:hover{text-decoration:none;transform:translateY(-3px);border-color:var(--border-strong)}
.news-visual{aspect-ratio:4/3;overflow:hidden;background:var(--bg-inset)}
.news-visual img{width:100%;height:100%;object-fit:cover;transition:transform .35s ease}
.news-tile:hover img{transform:scale(1.04)}
.news-placeholder{padding:22px;height:100%;display:flex;flex-direction:column;justify-content:space-between;color:var(--text-soft);border-bottom:3px solid var(--accent)}
.news-placeholder strong{font-family:var(--font-serif);font-size:2.6rem;color:var(--accent);font-weight:400;line-height:1}
.news-placeholder span:last-child{font-size:.65rem;letter-spacing:.08em}
.news-text{padding:20px;display:flex;flex-direction:column;flex:1}
.news-text h3{font-size:.98rem;line-height:1.65;font-weight:600;margin:0 0 20px;transition:color .16s ease}
.news-tile:hover h3{color:var(--accent)}
.news-bottom{display:flex;justify-content:space-between;align-items:center;margin-top:auto;color:var(--muted);font-size:.8rem;font-variant-numeric:tabular-nums}

/* ---------- 关于我们 ---------- */
.home-about{background:var(--bg-soft)}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.about-description{line-height:2;margin-bottom:26px}
.about-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;border-top:1px solid var(--border);margin-top:34px;padding-top:24px}
.about-stats strong{display:block;font-size:2.4rem;color:var(--accent);font-weight:400;font-variant-numeric:tabular-nums}
.about-stats span{font-size:.85rem;color:var(--muted)}
.about-visual{position:relative;display:block;min-height:340px;background:#25485e;color:#fff;border-radius:var(--radius);overflow:hidden}
.about-visual img{width:100%;height:360px;object-fit:cover}
.about-placeholder{min-height:360px;padding:44px;display:flex;flex-direction:column;justify-content:center}
.about-placeholder>span{font-family:var(--font-serif);font-size:4rem;letter-spacing:.1em;color:#a9cadb;line-height:1}
.about-placeholder strong{font-size:1.28rem;margin-top:8px}
.about-placeholder p{color:#d3e1e7;font-size:.85rem}
.about-caption{display:flex;justify-content:space-between;position:absolute;bottom:0;left:0;right:0;padding:15px 22px;background:rgba(19,46,67,.9);color:#fff;font-size:.85rem}

/* ---------- 招聘条 ---------- */
.home-join{padding:44px 0;border-top:1px solid var(--border)}
.join-inner{display:flex;align-items:center;justify-content:space-between;gap:30px}
.join-inner h2{font-size:1.28rem;margin-bottom:.2em}
.join-inner p{margin:0;max-width:50em;font-size:.9rem}

@media(max-width:1000px){
  .news-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .about-grid{gap:32px}
  .join-inner{flex-wrap:wrap;gap:18px}
}
@media(max-width:760px){
  .home-section{padding:52px 0}
  .about-grid{grid-template-columns:1fr}
  .about-visual img,.about-placeholder{height:300px;min-height:300px}
  .banner-controls{bottom:22px;gap:12px}
}
@media(max-width:600px){
  .banner-copy{padding-top:160px;padding-bottom:118px}
  .banner-slide{min-height:560px}
  .banner-summary,.banner-english{font-size:.98rem}
  .banner-decoration{right:-140px;width:260px}
  .home-heading{align-items:flex-start;gap:14px;flex-wrap:wrap}
  .home-lead{margin-bottom:26px}
  .news-grid{gap:14px}
  .news-text{padding:16px}
  .news-text h3{font-size:.94rem}
  .news-placeholder{padding:14px}
  .news-placeholder strong{font-size:2rem}
  .news-placeholder span:last-child{font-size:.55rem}
  .research-grid{grid-template-columns:1fr 1fr}
  .research-tile{min-height:240px;padding:22px 16px}
  .research-tile p{font-size:.78rem}
