---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadContent } from '../lib/content';
import { asset, u } from '../utils/url';
import { formatDate } from '../utils/format';
import { clampHomeCount, selectHomeHero } from '../utils/home.mjs';

const { site, homeSlides, research, members, news, publications: pubs } = await loadContent();
const copy = site.pageCopy;
const hero = selectHomeHero(homeSlides, {
  title: site.name,
  titleEn: site.nameEn,
  summary: site.tagline,
  image: site.groupPhoto,
  link: '/team',
  linkLabel: copy.home_team_action,
});
const stats = [
  { value: research.length, label: copy.home_stat_research, href: '/research' },
  { value: members.length, label: copy.home_stat_members, href: '/team' },
  { value: pubs.length, label: copy.home_stat_publications, href: '/publications' },
];
const latestNews = news.slice(0, clampHomeCount(copy.home_news_count, 4));
const contactEmail = (site.openings.enabled && site.openings.email) || site.contact.email;
---

<BaseLayout image={hero.image || site.groupPhoto}>
  <section class="home-hero" aria-labelledby="home-title">
    {hero.image && <img class="hero-image" src={asset(hero.image)} alt={hero.title} loading="eager" fetchpriority="high" />}
    <div class="container hero-copy">
      <p class="hero-affiliation">{site.affiliation}</p>
      <h1 id="home-title">{hero.title}</h1>
      {hero.titleEn && <p class="hero-english">{hero.titleEn}</p>}
      {hero.summary && <p class="hero-summary">{hero.summary}</p>}
      {hero.link && <a class="hero-link" href={u(hero.link)}>{hero.linkLabel || copy.home_slide_more}<span aria-hidden="true">→</span></a>}
    </div>
  </section>

  <section class="home-intro" aria-labelledby="intro-title">
    <div class="container intro-grid">
      <div>
        <div class="home-heading"><p>{copy.home_about_label}</p><h2 id="intro-title">{copy.home_about_title}</h2></div>
        <p class="intro-description">{site.description || site.tagline}</p>
        <a class="section-link" href={u('/team')}>{copy.home_team_action}<span aria-hidden="true">→</span></a>
        <div class="intro-stats">
          {stats.map((stat) => <a href={u(stat.href)}><strong>{stat.value}</strong><span>{stat.label}</span></a>)}
        </div>
      </div>
      {site.groupPhoto && <figure class="intro-photo"><img src={asset(site.groupPhoto)} alt={site.name + '团队合影'} loading="lazy" /><figcaption>{site.name} · {copy.home_team_action}</figcaption></figure>}
    </div>
  </section>

  <section class="home-latest" aria-labelledby="latest-title">
    <div class="container">
      <div class="section-top">
        <div class="home-heading"><p>{copy.home_news_label}</p><h2 id="latest-title">{copy.home_news_title}</h2></div>
        <a class="section-link" href={u('/news')}>{copy.home_news_action}<span aria-hidden="true">→</span></a>
      </div>
      {copy.home_news_intro && <p class="section-description">{copy.home_news_intro}</p>}
      <div class="news-grid">
        {latestNews.map((item) => (
          <article class="news-card">
            {item.cover && <a class="news-image" href={u('/news/' + item.slug)} tabindex="-1" aria-hidden="true"><img src={asset(item.cover)} alt={item.title} loading="lazy" /></a>}
            <div class="news-copy">
              <time datetime={item.date}>{formatDate(item.date)}</time>
              <h3><a href={u('/news/' + item.slug)}>{item.title}</a></h3>
              {item.summary && <p>{item.summary}</p>}
            </div>
          </article>
        ))}
      </div>
      {latestNews.length === 0 && <p>{copy.home_news_empty}</p>}
    </div>
  </section>

  <section class="home-contact" aria-labelledby="contact-title">
    <div class="container contact-grid">
      <div>
        <div class="home-heading"><p>{copy.contact_join_eyebrow}</p><h2 id="contact-title">{site.openings.enabled ? site.openings.title : copy.contact_title}</h2></div>
        <p>{site.openings.enabled ? site.openings.text : copy.contact_intro}</p>
        <a class="section-link" href={u(site.openings.enabled ? '/join' : '/contact')}>{site.openings.enabled ? copy.home_join_action : copy.contact_title}<span aria-hidden="true">→</span></a>
      </div>
      <address class="contact-details">
        {site.contact.address && <div><span>{copy.contact_address_label}</span><p>{site.contact.address}</p></div>}
        {contactEmail && <div><span>{copy.contact_email_label}</span><a href={'mailto:' + contactEmail}>{contactEmail}</a></div>}
        {site.contact.phone && <div><span>{copy.contact_phone_label}</span><p>{site.contact.phone}</p></div>}
        <a class="section-link" href={u('/contact')}>{copy.contact_title}<span aria-hidden="true">→</span></a>
      </address>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero { position: relative; isolation: isolate; display: flex; align-items: end; min-height: clamp(480px, 70vh, 760px); background: var(--brand-blue); color: #fff; overflow: hidden; }
  .hero-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .home-hero:has(.hero-image)::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(5, 24, 52, .78), rgba(5, 24, 52, .12)), linear-gradient(0deg, rgba(5, 24, 52, .4), transparent 70%); z-index: -1; }
  .hero-copy { padding-block: 110px 88px; }
  .hero-affiliation { color: #d9e8ff; font-size: .9rem; letter-spacing: .08em; margin-bottom: 24px; }
  .hero-copy h1 { color: #fff; max-width: 18em; font-size: clamp(2rem, 4vw, 3.6rem); font-weight: 600; line-height: 1.32; text-wrap: balance; }
  .hero-english { font-size: 1.1rem; color: #e2ecfa; margin-bottom: 24px; }
  .hero-summary { max-width: 40em; color: #edf3fc; font-size: 1.06rem; }
  .hero-link { display: inline-flex; align-items: center; gap: 40px; min-height: 44px; margin-top: 20px; padding-block: 10px; color: #fff; border-bottom: 1px solid #b9d0ed; }
  .hero-link:focus-visible { outline-color: #fff; }
  .home-intro, .home-latest, .home-contact { padding-block: 80px; }
  .home-heading p { color: var(--accent); font-size: .76rem; letter-spacing: .12em; text-transform: uppercase; margin-bottom: 10px; }
  .home-heading h2 { font-size: clamp(1.6rem, 2.6vw, 2.1rem); font-weight: 600; margin-bottom: 24px; }
  .intro-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 64px; align-items: center; }
  .intro-grid:has(.intro-photo) { grid-template-columns: minmax(0, 1fr) minmax(0, .9fr); }
  .intro-description { max-width: 62em; line-height: 2; }
  .section-link { display: inline-flex; align-items: center; min-height: 44px; gap: 24px; font-size: .9rem; font-weight: 600; }
  .intro-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; padding-top: 24px; margin-top: 32px; border-top: 1px solid var(--border); }
  .intro-stats a { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; color: var(--text-soft); min-height: 44px; }
  .intro-stats strong { font-size: 2.4rem; line-height: 1.2; font-weight: 500; color: var(--accent); font-variant-numeric: tabular-nums; }
  .intro-stats span { font-size: .85rem; }
  .intro-photo { margin: 0; }
  .intro-photo img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .intro-photo figcaption { color: var(--muted); font-size: .8rem; padding-top: 12px; }
  .home-latest { background: var(--bg-soft); border-block: 1px solid var(--border); }
  .section-top { display: flex; justify-content: space-between; align-items: center; gap: 24px; }
  .section-description { max-width: 65ch; margin-bottom: 32px; }
  .news-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; }
  .news-card { min-width: 0; border-top: 2px solid var(--border-strong); }
  .news-image { display: block; aspect-ratio: 4 / 3; overflow: hidden; margin-top: -2px; }
  .news-image img { height: 100%; width: 100%; object-fit: cover; }
  .news-copy { padding-top: 22px; }
  .news-copy time { font-size: .8rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .news-copy h3 { font-size: 1.05rem; line-height: 1.65; margin: 12px 0; font-weight: 600; }
  .news-copy h3 a { color: var(--text); display: block; min-height: 44px; }
  .news-copy h3 a:hover { color: var(--accent); }
  .news-copy p { font-size: .86rem; line-height: 1.8; margin-bottom: 0; }
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 96px; }
  .contact-grid > div > p { max-width: 54ch; }
  .contact-details { font-style: normal; border-left: 1px solid var(--border); padding-left: 40px; }
  .contact-details > div { margin-bottom: 18px; }
  .contact-details > div > span { display: block; color: var(--muted); font-size: .78rem; margin-bottom: 4px; }
  .contact-details p { font-size: .9rem; margin: 0; }
  .contact-details > div > a { display: inline-flex; align-items: center; min-height: 44px; overflow-wrap: anywhere; max-width: 100%; }
  @media (max-width: 1024px) {
    .news-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
    .intro-grid { gap: 36px; }
    .contact-grid { gap: 48px; }
  }
  @media (max-width: 768px) {
    .home-hero { min-height: 560px; min-height: min(640px, 80svh); }
    .hero-copy { padding-block: 80px 56px; }
    .hero-copy h1 { font-size: clamp(2rem, 6vw, 2.8rem); }
    .home-intro, .home-latest, .home-contact { padding-block: 52px; }
    .intro-grid:has(.intro-photo), .contact-grid { grid-template-columns: 1fr; }
    .contact-details { border-left: 0; border-top: 1px solid var(--border); padding: 28px 0 0; }
    .section-top { align-items: flex-start; flex-wrap: wrap; gap: 0 20px; margin-bottom: 20px; }
    .section-top h2 { margin-bottom: 8px; }
    .hero-english, .hero-summary { font-size: .98rem; }
    .intro-stats a { flex-direction: column; gap: 8px; }
  }
  @media (max-width: 390px) {
    .hero-copy { padding-block: 64px 44px; }
    .hero-copy h1 { font-size: 1.85rem; }
    .hero-affiliation { font-size: .8rem; }
    .news-grid { grid-template-columns: 1fr; }
    .intro-stats { gap: 12px; }
    .intro-stats strong { font-size: 2rem; }
  }
  @media (max-width: 320px) {
    .hero-copy h1 { font-size: 1.7rem; }
    .intro-stats span { font-size: .78rem; }
    .home-heading h2 { font-size: 1.5rem; }
  }
  @media print {
    .home-hero { min-height: auto; background: #fff; color: #000; }
    .hero-image, .home-hero::after { display: none; }
    .hero-copy { padding-block: 20px; }
    .hero-copy :is(h1, p, a) { color: #000; }
    .home-intro, .home-latest, .home-contact { padding-block: 20px; }
    .news-grid { display: block; }
    .news-card { break-inside: avoid; margin-bottom: 20px; }
  }
</style>
