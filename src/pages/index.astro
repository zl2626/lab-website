---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ResearchCard from '../components/ResearchCard.astro';
import NewsCard from '../components/NewsCard.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { getMembers, getNews, getPublications, getResearch, getSite } from '../lib/content';
import { u } from '../utils/url';

const site = await getSite();
const research = await getResearch();
const members = await getMembers();
const news = await getNews();
const pubs = await getPublications();

const latestNews = news.slice(0, 3);
const highlights = pubs.filter((p) => p.highlight).slice(0, 4);

const years = pubs.map((p) => p.year).filter((y) => y > 0);
const span =
  years.length > 0
    ? Math.min(...years) === Math.max(...years)
      ? String(Math.min(...years))
      : `${Math.min(...years)}–${Math.max(...years)}`
    : '—';

const stats = [
  { num: String(research.length), label: '研究方向' },
  { num: String(members.length), label: '团队成员' },
  { num: String(pubs.length), label: '科研成果' },
  { num: span, label: '论文年份跨度' },
];
---

<BaseLayout>
  <!-- ===== Hero ===== -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <span class="pill">{site.abbr} · Research Group</span>
      <h1>{site.name}</h1>
      {site.tagline && <p class="tagline">{site.tagline}</p>}
      {site.affiliation && <p class="affil">{site.affiliation}</p>}
      <div class="row ctas">
        <a class="btn btn-primary" href={u('/research')}>了解研究方向</a>
        <a class="btn btn-ghost" href={u('/publications')}>查看科研成果</a>
      </div>

      <div class="stats">
        {
          stats.map((s) => (
            <div class="stat">
              <strong>{s.num}</strong>
              <span>{s.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== 研究方向 ===== -->
  <section class="section container">
    <SectionHeading
      eyebrow="Research"
      title="研究方向"
      description="课题组围绕以下方向开展前沿研究，注重理论与实际系统的结合。"
      actionLabel="全部方向"
      actionHref="/research"
    />
    <div class="grid auto-grid">
      {research.slice(0, 6).map((item, i) => <ResearchCard item={item} index={i} />)}
    </div>
  </section>

  <!-- ===== 最新动态 ===== -->
  <section class="section section-alt">
    <div class="container">
      <SectionHeading
        eyebrow="News"
        title="最新科研动态"
        description="论文发表、获奖、学术活动与课题组公告。"
        actionLabel="全部新闻"
        actionHref="/news"
      />
      {latestNews.length > 0 ? (
        <div class="grid grid-3">
          {latestNews.map((item, i) => <NewsCard item={item} index={i} />)}
        </div>
      ) : (
        <p class="muted">暂无新闻。</p>
      )}
    </div>
  </section>

  <!-- ===== 精选成果 ===== -->
  <section class="section container">
    <SectionHeading
      eyebrow="Publications"
      title="代表性成果"
      description="近年来的部分代表性论文与获奖成果。"
      actionLabel="完整成果列表"
      actionHref="/publications"
    />
    {highlights.length > 0 ? (
      <div class="pub-list">
        {highlights.map((item) => <PublicationItem item={item} />)}
      </div>
    ) : (
      <p class="muted">暂无精选成果，请在后台把成果勾选为「精选」。</p>
    )}
  </section>

  <!-- ===== 加入我们 ===== -->
  {
    site.openings.enabled && site.openings.title && (
      <section class="section container">
        <div class="join">
          <div>
            <span class="eyebrow">Join Us</span>
            <h2>{site.openings.title}</h2>
            {site.openings.text && <p>{site.openings.text}</p>}
          </div>
          <a class="btn btn-primary" href={u('/contact')}>
            联系我们
          </a>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* Hero */
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--border); }
  .hero-bg {
    position: absolute; inset: 0; z-index: 0;
    background:
      radial-gradient(60% 80% at 82% 8%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 60%),
      radial-gradient(50% 70% at 8% 90%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 65%),
      var(--bg-soft);
  }
  .hero-inner { position: relative; z-index: 1; padding: 92px 0 68px; }
  .pill {
    display: inline-block; padding: 5px 14px; border-radius: 999px; font-size: 0.78rem;
    font-weight: 700; letter-spacing: 0.05em; color: var(--accent);
    background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    margin-bottom: 20px;
  }
  .hero h1 { margin-bottom: 0.3em; max-width: 20ch; }
  .tagline { font-size: clamp(1.02rem, 2vw, 1.24rem); color: var(--text-soft); max-width: 62ch; margin-bottom: 0.4em; }
  .affil { font-size: 0.92rem; color: var(--muted); }
  .ctas { gap: 12px; margin: 26px 0 46px; }

  .stats {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px;
    padding-top: 30px; border-top: 1px solid var(--border);
  }
  .stat { display: flex; flex-direction: column; gap: 2px; }
  .stat strong { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 750; letter-spacing: -0.02em; color: var(--text); }
  .stat span { font-size: 0.82rem; color: var(--muted); }
  @media (max-width: 620px) { .stats { grid-template-columns: repeat(2, 1fr); } .hero-inner { padding: 56px 0 46px; } }

  /* 精选成果列表 */
  .pub-list { border-top: 1px solid var(--border); }
  .pub-list :global(.pub:first-child) { padding-top: 24px; }

  /* 加入我们 */
  .join {
    display: flex; align-items: center; justify-content: space-between; gap: 28px; flex-wrap: wrap;
    padding: 38px 40px; border-radius: var(--radius);
    background: linear-gradient(130deg, var(--accent-soft), var(--bg-soft));
    border: 1px solid color-mix(in srgb, var(--accent) 20%, var(--border));
  }
  .join h2 { margin: 0.25em 0 0.4em; }
  .join p { max-width: 62ch; margin: 0; }
  .eyebrow {
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent);
  }
</style>
