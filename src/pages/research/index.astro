---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchCard from '../../components/ResearchCard.astro';
import { getResearch, getSite } from '../../lib/content';

const site = await getSite();
const research = await getResearch();
---

<BaseLayout title="研究方向" description={`${site.name}的研究方向`}>
  <div class="page-head">
    <div class="container">
      <h1>研究方向</h1>
      <p>课题组围绕以下前沿方向开展系统性研究，点击卡片可查看每个方向的具体内容与相关工作。</p>
    </div>
  </div>

  <section class="section container">
    <div class="grid auto-grid">
      {research.map((item, i) => <ResearchCard item={item} index={i} />)}
    </div>
    {research.length === 0 && <p class="muted">暂无研究方向内容。</p>}
  </section>
</BaseLayout>
