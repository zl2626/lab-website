---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchCard from '../../components/ResearchCard.astro';
import { getResearch, getSite } from '../../lib/content';

const site = await getSite();
const copy = site.pageCopy;
const research = await getResearch();
---

<BaseLayout title={copy.research_title} description={`${site.name}的研究方向`}>
  <div class="page-head">
    <div class="container">
      <h1>{copy.research_title}</h1>
      <p>{copy.research_intro}</p>
    </div>
  </div>

  <section class="section container">
    <div class="grid auto-grid">
      {research.map((item, i) => <ResearchCard item={item} index={i} copy={copy} />)}
    </div>
    {research.length === 0 && <p class="muted">{copy.research_empty}</p>}
  </section>
</BaseLayout>
