---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationItem from '../../components/PublicationItem.astro';
import { getPublications, getResearch, getSite } from '../../lib/content';
import { asset, u } from '../../utils/url';

export async function getStaticPaths() {
  const research = await getResearch();
  return research.map((item) => ({ params: { id: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const copy = (await getSite()).pageCopy;

const allResearch = await getResearch();
const others = allResearch.filter((r) => r.slug !== item.slug);

const pubs = await getPublications();
const related = pubs.filter((p) => p.area && p.area === item.title);
---

<BaseLayout title={item.title} description={item.summary}>
  <div class="page-head">
    <div class="container">
      <p class="crumb"><a href={u('/research')}>{copy.research_title}</a> / {item.title}</p>
      <h1><span class="icon">{item.icon}</span> {item.title}</h1>
      {item.titleEn && <p class="en">{item.titleEn}</p>}
      {
        item.keywords.length > 0 && (
          <div class="row tags">
            {item.keywords.map((k) => (
              <span class="tag tag-muted">{k}</span>
            ))}
          </div>
        )
      }
    </div>
  </div>

  <section class="section-detail container">
    {item.cover && <img class="research-cover" src={asset(item.cover)} alt={item.title} />}
    <div class="prose" set:html={item.bodyHtml} />
  </section>

  {
    others.length > 0 && (
      <section class="section-tight container">
        <h2 class="sub-head">{copy.research_others}</h2>
        <div class="row others">
          {others.map((o) => (
            <a class="btn btn-ghost sm" href={u(`/research/${o.slug}`)}>
              <span aria-hidden="true">{o.icon}</span> {o.title}
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="section section-alt">
        <div class="container">
          <h2 class="sub-head">{copy.research_related}</h2>
          <div class="pub-list">
            {related.map((p) => (
              <PublicationItem item={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .research-cover { max-height: 420px; object-fit: cover; border-radius: var(--radius); margin-bottom: 28px; }
  .crumb { font-size: 0.85rem; color: var(--muted); margin-bottom: 12px; }
  .icon { font-size: 0.85em; }
  .en { color: var(--muted); font-size: 1rem; margin: 0 0 0.8em; }
  .tags { gap: 7px; }
  .pub-list { border-top: 1px solid var(--border); }
  /* 两个次级标题（其他研究方向 / 本方向相关工作）保持同一视觉层级 */
  .sub-head {
    display: flex; align-items: center; gap: 10px;
    font-size: 1.12rem; font-weight: 700; margin-bottom: 18px;
  }
  .sub-head::before {
    content: ''; width: 3px; height: 1.05em; flex: 0 0 3px;
    background: var(--accent); border-radius: 2px;
  }
  .others { gap: 10px; }
  .others .btn.sm { padding: 8px 16px; font-size: 0.88rem; }
</style>
