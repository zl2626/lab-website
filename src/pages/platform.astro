---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRobotProjects, getSite } from '../lib/content';
import { u } from '../utils/url';

const site = await getSite();
const copy = site.pageCopy;
const projects = await getRobotProjects();
---

<BaseLayout title={copy.platform_title} description={`${site.name}的机器人科研平台`}>
  <div class="page-head">
    <div class="container">
      <h1>{copy.platform_title}</h1>
      <p>{copy.platform_intro}</p>
    </div>
  </div>

  <section class="section container">
    <div class="platform-note">
      <strong>{copy.platform_note_title}</strong>
      <span>{copy.platform_note_text}</span>
    </div>

    <div class="project-grid">
      {
        projects.map((item) => (
          <article class="project card">
            <div class="project-top">
              <span class="tag">{item.modelFormat || copy.platform_note_title}</span>
              {item.researchFocus && <span class="muted small">{item.researchFocus}</span>}
            </div>
            <h2>{item.name}</h2>
            {item.summary && <p>{item.summary}</p>}
            <div class="project-actions">
              {item.modelUrl && <a class="btn btn-primary" href={item.modelUrl} target="_blank" rel="noopener">{copy.platform_model_action}</a>}
              {item.demoUrl && <a class="btn btn-ghost" href={item.demoUrl} target="_blank" rel="noopener">{copy.platform_demo_action}</a>}
            </div>
          </article>
        ))
      }
    </div>

    {
      projects.length === 0 && (
        <div class="empty">
          <h2>{copy.platform_empty_title}</h2>
          <p>{copy.platform_empty_text}</p>
          <a class="btn btn-primary" href={u('/api/admin/core/robotproject/add/')}>{copy.platform_empty_action}</a>
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .platform-note { display: flex; gap: 16px; align-items: baseline; border-bottom: 1px solid var(--border); padding-bottom: 18px; margin-bottom: 22px; }
  .platform-note strong { font-size: 1.2rem; }
  .platform-note span { color: var(--muted); font-size: .9rem; }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .project h2 { font-size: 1.2rem; margin: 14px 0 8px; }
  .project p { min-height: 3em; }
  .project-top, .project-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .empty { padding: 48px 0; text-align: center; border: 1px dashed var(--border-strong); }
  @media (max-width: 700px) {
    .project-grid { grid-template-columns: 1fr; }
    .platform-note { display: block; }
    .platform-note span { display: block; margin-top: 6px; }
  }
</style>
