---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSite } from '../lib/content';
import { u } from '../utils/url';

const site = await getSite();
const copy = site.pageCopy;
const links = site.nav.filter((item) => item.href !== '/');
---

<BaseLayout title={copy.error_title}>
  <section class="section container not-found">
    <p class="code" aria-hidden="true">404</p>
    <h1>{copy.error_title}</h1>
    <p class="muted lead">{copy.error_text}</p>

    <div class="actions">
      <button type="button" class="btn btn-primary" data-search-open>
        <span aria-hidden="true">⌕</span> {copy.error_search_action}
      </button>
      <a class="btn btn-ghost" href={u('/')}>{copy.error_home_action}</a>
    </div>

    <nav class="quick" aria-label={copy.error_nav_label}>
      {links.map((item) => (
        <a href={u(item.href)}>{item.label}</a>
      ))}
    </nav>
  </section>
</BaseLayout>

<style>
  .not-found { padding: 84px 0 96px; text-align: center; }
  .code {
    font-size: clamp(3.4rem, 10vw, 5.2rem); font-weight: 800; line-height: 1;
    color: var(--accent); margin: 0 0 6px; letter-spacing: -0.04em;
  }
  .not-found h1 { margin-bottom: .35em; }
  .lead { max-width: 46ch; margin: 0 auto 30px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .quick {
    display: flex; flex-wrap: wrap; gap: 10px; justify-content: center;
    margin-top: 40px; padding-top: 28px; border-top: 1px solid var(--border);
  }
  .quick a {
    font-size: .88rem; font-weight: 600; padding: 8px 16px;
    border: 1px solid var(--border); border-radius: 999px; color: var(--text-soft);
  }
  .quick a:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }
</style>
