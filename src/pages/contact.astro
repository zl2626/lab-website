---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSite } from '../lib/content';

const site = await getSite();
const copy = site.pageCopy;
const { contact, openings } = site;
---

<BaseLayout title={copy.contact_title} description={`联系${site.name}`}>
  <div class="page-head">
    <div class="container">
      <h1>{copy.contact_title}</h1>
      <p>{copy.contact_intro}</p>
    </div>
  </div>

  <section class="section container">
    <div class="grid grid-3">
      <div class="card info-card">
        <span class="ic">📍</span>
        <h3>{copy.contact_address_label}</h3>
        <p>{contact.address || '—'}{contact.postcode ? `，邮编 ${contact.postcode}` : ''}</p>
      </div>
      <div class="card info-card">
        <span class="ic">✉️</span>
        <h3>{copy.contact_email_label}</h3>
        <p>{contact.email ? <a href={`mailto:${contact.email}`}>{contact.email}</a> : '—'}</p>
      </div>
      <div class="card info-card">
        <span class="ic">☎️</span>
        <h3>{copy.contact_phone_label}</h3>
        <p>{contact.phone || '—'}</p>
      </div>
    </div>

    {
      openings.enabled && openings.title && (
        <div class="join">
          <span class="eyebrow">Join Us</span>
          <h2>{openings.title}</h2>
          {openings.text && <p>{openings.text}</p>}
          {(openings.email || contact.email) && (
            <a
              class="btn btn-primary"
              href={`mailto:${openings.email || contact.email}?subject=${encodeURIComponent(copy.contact_apply_subject)}`}
            >
              {copy.contact_apply_label}
            </a>
          )}
        </div>
      )
    }

    {(copy.contact_map_text || copy.contact_map_url) && (
      <div class="map-placeholder card">
        <h3>{copy.contact_map_title}</h3>
        {copy.contact_map_text && <p style="white-space: pre-line">{copy.contact_map_text}</p>}
        {copy.contact_map_url && <a class="btn btn-ghost" href={copy.contact_map_url} target="_blank" rel="noopener">在地图中查看</a>}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .info-card { text-align: center; }
  .info-card .ic { font-size: 1.7rem; display: block; margin-bottom: 12px; }
  .info-card h3 { font-size: 1rem; margin-bottom: 0.4em; }
  .info-card p { margin: 0; font-size: 0.94rem; }

  .join {
    margin-top: 44px; padding: 38px 40px; border-radius: var(--radius);
    background: linear-gradient(130deg, var(--accent-soft), var(--bg-soft));
    border: 1px solid color-mix(in srgb, var(--accent) 20%, var(--border));
  }
  .join h2 { margin: 0.3em 0 0.5em; }
  .join p { max-width: 66ch; }
  .eyebrow {
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent);
  }

  .map-placeholder { margin-top: 44px; }
  .map-placeholder h3 { margin-bottom: 0.3em; }
</style>
