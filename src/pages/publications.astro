---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { fillCopy, getMembers, getPublications, getSite } from '../lib/content';
import { groupByYear } from '../utils/format';
import { buildAuthorIndex, membersWithPublications, normalizeName } from '../utils/authors.mjs';

const site = await getSite();
const copy = site.pageCopy;
const [pubs, members] = await Promise.all([getPublications(), getMembers()]);

const years = groupByYear(pubs, (p) => p.year);
const types = [...new Set(pubs.map((p) => p.type))];
const areas = [...new Set(pubs.map((p) => p.area).filter(Boolean))];

// 作者联动：把成果里的作者名匹配到本站成员，用于「作者可点」与「按作者筛选」
const memberByAuthor = buildAuthorIndex(members);
const authorOptions = membersWithPublications(members, pubs);

const typeCounts = types
  .map((type) => ({ type, count: pubs.filter((p) => p.type === type).length }))
  .sort((a, b) => b.count - a.count);

const yearRange =
  years.length > 1 ? `${years[years.length - 1].year}–${years[0].year}` : String(years[0]?.year ?? '—');

// 筛选结果的条数与导出按钮的反馈都在客户端生成，把模板一并下发，避免把文案写进脚本
const clientCopy = {
  unit: copy.pub_unit,
  resultCount: copy.pub_result_count,
  yearCount: copy.pub_year_count,
  exportDone: copy.pub_export_done,
  exportEmpty: copy.pub_export_empty,
  exportHeader: copy.pub_export_header,
  siteName: site.name,
};
---

<BaseLayout title={copy.publications_title} description={`${site.name}的科研成果与论文列表`}>
  <div class="page-head">
    <div class="container">
      <h1>{copy.publications_title}</h1>
      <p>{fillCopy(copy.publications_intro, { count: pubs.length })}</p>

      <form class="filters" role="search" aria-label={copy.publications_title} onsubmit="return false">
        <label class="search-field">{copy.pub_filter_keyword}
          <input id="pub-search" type="search" placeholder={copy.pub_filter_placeholder} />
        </label>
        <label>{copy.pub_filter_year}<select id="pub-year"><option value="">{copy.pub_filter_year_all}</option>{years.map(({ year }) => <option value={year}>{year}</option>)}</select></label>
        <label>{copy.pub_filter_type}<select id="pub-type"><option value="">{copy.pub_filter_type_all}</option>{types.map((t) => <option value={t}>{t}</option>)}</select></label>
        <label>{copy.pub_filter_area}<select id="pub-area"><option value="">{copy.pub_filter_area_all}</option>{areas.map((a) => <option value={a}>{a}</option>)}</select></label>
        {
          authorOptions.length > 0 && (
            <label>{copy.pub_filter_author}
              <select id="pub-author">
                <option value="">{copy.pub_filter_author_all}</option>
                {authorOptions.map((member) => (
                  <option value={normalizeName(member.nameEn) || normalizeName(member.name)}>
                    {member.name}{member.role ? `（${member.role}）` : ''}
                  </option>
                ))}
              </select>
            </label>
          )
        }
        <button type="reset" class="reset-filter">{copy.pub_filter_reset}</button>
        <button type="button" class="export-filter" id="export-bib" data-site={site.name} title={copy.pub_export_hint}>
          {copy.pub_export}
        </button>
      </form>
      <p id="result-count" class="small muted" role="status" aria-live="polite">{fillCopy(copy.pub_result_initial, { count: pubs.length })}</p>
    </div>
  </div>

  <section class="section container">
    {
      pubs.length > 0 && (
        <div class="stat-strip">
          <div class="item">
            <b>{pubs.length}</b>
            <span>{copy.pub_stat_total}</span>
          </div>
          {typeCounts.map((t) => (
            <div class="item">
              <b>{t.count}</b>
              <span>{t.type}</span>
            </div>
          ))}
          <div class="item">
            <b>{yearRange}</b>
            <span>{copy.pub_stat_span}</span>
          </div>
        </div>
      )
    }
    {
      years.map(({ year, items }) => (
        <div class="year-block">
          <div class="year-head">
            <h2>{year}</h2>
            <span class="muted small year-count">{items.length} {copy.pub_unit}</span>
          </div>
          <div class="pub-list">
            {items.map((item) => (
              <div
                class="pub-cell"
                data-type={item.type}
                data-area={item.area}
                data-year={item.year}
                data-authors={item.authors.map(normalizeName).join('|')}
                data-search={[item.title, ...item.authors, item.venue, item.venueShort].join(" ").toLocaleLowerCase()}
              >
                <PublicationItem item={item} copy={copy} memberByAuthor={memberByAuthor} />
              </div>
            ))}
          </div>
        </div>
      ))
    }
    {
      pubs.length === 0 && (
        <p class="muted">{copy.pub_empty}</p>
      )
    }
    <p id="no-result" class="muted" hidden>{copy.pub_empty_filter}</p>
  </section>

  <script type="application/json" id="pub-client-copy" set:html={JSON.stringify(clientCopy)} />

<script>
  import { downloadText } from '../utils/clipboard.mjs';
  import { fillCopy } from '../utils/copy.mjs';

  // 文案由服务端下发，避免把界面文字写死在脚本里
  const clientCopy = JSON.parse(document.getElementById('pub-client-copy')?.textContent || '{}') as {
    unit?: string;
    resultCount?: string;
    yearCount?: string;
    exportDone?: string;
    exportEmpty?: string;
    exportHeader?: string;
    siteName?: string;
  };

  const form = document.querySelector<HTMLFormElement>('.filters')!;
  const search = document.querySelector<HTMLInputElement>('#pub-search')!;
  const year = document.querySelector<HTMLSelectElement>('#pub-year')!;
  const type = document.querySelector<HTMLSelectElement>('#pub-type')!;
  const area = document.querySelector<HTMLSelectElement>('#pub-area')!;
  const author = document.querySelector<HTMLSelectElement>('#pub-author');
  const cells = Array.from(document.querySelectorAll<HTMLElement>('.pub-cell'));
  const blocks = Array.from(document.querySelectorAll<HTMLElement>('.year-block'));
  const empty = document.getElementById('no-result')!;
  const count = document.getElementById('result-count')!;
  const exportButton = document.getElementById('export-bib') as HTMLButtonElement | null;

  function update() {
    const words = search.value.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);
    const authorKey = author?.value ?? '';
    let visible = 0;
    cells.forEach((cell) => {
      const show = (!year.value || cell.dataset.year === year.value)
        && (!type.value || cell.dataset.type === type.value)
        && (!area.value || cell.dataset.area === area.value)
        && (!authorKey || (cell.dataset.authors || '').split('|').includes(authorKey))
        && words.every((word) => (cell.dataset.search || '').includes(word));
      cell.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    blocks.forEach((block) => {
      const total = Array.from(block.querySelectorAll<HTMLElement>('.pub-cell'))
        .filter((cell) => cell.style.display !== 'none').length;
      block.hidden = total === 0;
      const label = block.querySelector('.year-count');
      if (label) label.textContent = fillCopy(clientCopy.yearCount || '{count}', { count: total });
    });
    count.textContent = fillCopy(clientCopy.resultCount || '{shown} / {total}', { shown: visible, total: cells.length });
    empty.hidden = visible > 0 || cells.length === 0;
  }

  form.addEventListener('input', update);
  form.addEventListener('change', update);
  form.addEventListener('reset', () => { setTimeout(update, 0); });
  update();

  // 把当前筛选结果导出成一个 .bib 文件；引用文本直接取自各条目已渲染的 BibTeX 区块，不重复计算
  exportButton?.addEventListener('click', () => {
    const chunks = cells
      .filter((cell) => cell.style.display !== 'none')
      .map((cell) => cell.querySelector('article.pub pre code')?.textContent ?? '')
      .map((text) => text.trim())
      .filter(Boolean);

    const original = exportButton.textContent ?? '';

    // 统一的「改了文案 → 过一会儿再变回去」反馈
    const flash = (text: string) => {
      exportButton.textContent = text;
      exportButton.classList.add('is-done');
      window.setTimeout(() => {
        exportButton.textContent = original;
        exportButton.classList.remove('is-done');
      }, 2000);
    };

    if (chunks.length === 0) {
      flash(clientCopy.exportEmpty || original);
      return;
    }

    const today = new Date();
    const stamp = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
    const header = fillCopy(
      clientCopy.exportHeader || '% {site}\n% {date} · {count}',
      { site: exportButton.dataset.site || clientCopy.siteName || '', date: stamp, count: chunks.length }
    );
    downloadText(`publications-${stamp}.bib`, `${header}\n\n` + chunks.join('\n'));

    flash(fillCopy(clientCopy.exportDone || '{count}', { count: chunks.length }));
  });
</script>
</BaseLayout>

<style>
  .filters { display: flex; flex-wrap: wrap; align-items: end; gap: 12px; margin: 26px 0 14px; }
  .filters label { display: flex; flex-direction: column; gap: 6px; font-size: .82rem; font-weight: 600; color: var(--muted); }
  .search-field { flex: 1 1 260px; }
  .filters input, .filters select, .reset-filter {
    min-height: 42px; padding: 9px 12px;
    border: 1px solid var(--border); border-radius: 8px;
    background: var(--bg); color: var(--text); font: inherit; font-weight: 400;
    transition: border-color .16s ease, box-shadow .16s ease;
  }
  .filters input:hover, .filters select:hover { border-color: var(--border-strong); }
  .filters input:focus-visible, .filters select:focus-visible {
    outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .filters select { max-width: 100%; }
  .reset-filter { cursor: pointer; color: var(--accent); font-weight: 600; }
  .reset-filter:hover { border-color: var(--accent); background: var(--accent-soft); }
  .export-filter { cursor: pointer; color: var(--text-soft); font-weight: 600; }
  .export-filter:hover { border-color: var(--accent); color: var(--accent); }
  .export-filter.is-done { color: var(--gold); border-color: var(--gold); }
  @media (max-width: 600px) { .filters label { flex: 1 1 100%; min-width: 0; } }

  .year-block { margin-bottom: 40px; }
  .year-head {
    display: flex; align-items: baseline; gap: 12px; margin-bottom: 6px;
    position: sticky; top: var(--header-h); background: var(--bg);
    padding: 14px 0 8px; z-index: 5;
    border-bottom: 1px solid var(--border);
  }
  .year-head h2 { margin: 0; font-size: 1.4rem; }
  .pub-cell { display: contents; }
</style>

