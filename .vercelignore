# 部署到 Vercel 时不需上传的文件（加速上传、避免把本地数据带上去）

# 依赖与虚拟环境
node_modules/
.venv/
venv/

# 本地数据库：线上用 PostgreSQL，绝不要上传本地 SQLite
db.sqlite3
db.sqlite3-journal
api/staticfiles/

# 构建产物（Vercel 会自己重新构建）
dist/
.astro/

# 本地环境变量（线上变量在 Vercel 项目设置里）
.env
.env.*
!.env.example

# 内部目录与临时产物
.workbuddy/
_shots/
.git/

# 缓存与日志
*.log
__pycache__/
*.py[cod]
