# build output
dist/
.output/
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment
.env
.env.*
!.env.example

# ---------- Python / Django ----------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# 本地 SQLite 数据库（线上用 PostgreSQL，不入库）
/db.sqlite3
/db.sqlite3-journal

# collectstatic 产物（本方案用 WhiteNoise finders，不需要提交）
api/staticfiles/

# 本地从 Vercel 拉下来的环境变量
.env.local

# Vercel CLI 的本地关联信息（含项目 ID，不入库）
.vercel/

# macOS / Windows
.DS_Store
Thumbs.db

# editors
.vscode/*
!.vscode/extensions.json
.idea/

# 内部工作目录 / 截图等临时产物
# 注意用 _shots* 而不是 _shots/：脚本偶尔会把截图写到根目录（如 _shots$xx.png），
# 只有目录形式的规则拦不住这种文件
.workbuddy/
_shots*

.vercel
.env*
# GitHub Actions workflow
# 当前用于推送的 token 只有 repo 权限、缺 workflow 权限，一旦推送 .github/workflows/ 下的文件
# GitHub 会直接拒收整次推送。所以先本地忽略，等换成带 workflow 权限的 token 后删掉本规则
# 即可启用 Actions 方式发布（详见 README 第五节 步骤 8）。
.github/workflows/

